# Build context for apps/api/Dockerfile: an allow-list. Nothing else (no
# .env files, no node_modules, no dist, no app, no vendor snapshots, no docs,
# no ops scripts or recovery material) is sent to the builder.
*
!package.json
!package-lock.json
!apps/app/package.json
!apps/api/package.json
!apps/api/.swcrc
!apps/api/tsconfig.json
!apps/api/release-graph.json
!apps/api/drizzle/
!apps/api/scripts/release-graph.mjs
!apps/api/scripts/release-smoke.cjs
!apps/api/src/
!packages/contracts/package.json
!packages/contracts/src/
!scripts/ci/linux-native-bindings.mjs
