{
  "name": "gogospend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/api",
    "apps/app",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:v1": "node scripts/dev-v1.mjs",
    "db:v1:up": "node scripts/dev-v1.mjs db-up",
    "dev:edge": "node apps/edge/scripts/dev.mjs",
    "test:dev": "node --experimental-vm-modules --test scripts/dev.test.mjs scripts/dev-v1.test.mjs",
    "test:ops": "node --test scripts/ops/recovery-inventory.test.mjs scripts/ops/restore-safety.test.mjs scripts/ops/local-rehearsal.test.mjs scripts/ops/performance-smoke.test.mjs scripts/ops/backup-age.test.mjs scripts/ops/readiness-receipts.test.mjs scripts/ci/lockfile-bindings.test.mjs scripts/ci/backend-workflow.test.mjs",
    "ops:rehearsal:local": "node scripts/dev-v1.mjs db-up && node scripts/ops/restore-rehearsal.mjs --target local-isolated-synthetic",
    "test:db": "npm run test:db -w gogospend-api",
    "test:app": "npm run test -w gogospend-app",
    "test:unit": "npm run test:unit -w gogospend-app",
    "typecheck": "npm run typecheck -w @gogospend/contracts && npm run typecheck -w gogospend-api",
    "typecheck:app": "npm run typecheck -w gogospend-app",
    "test:api": "npm run test -w gogospend-api",
    "diff:api-spend": "diff -r vendor/gogocash-apps-api-spend apps/api/src/spend || true",
    "diff:app-spend": "diff -r vendor/gogocash-apps-app-spend apps/app/src/spend || true",
    "install:edge": "npm ci --prefix apps/edge --no-audit --no-fund",
    "typecheck:edge": "npm run typecheck --prefix apps/edge",
    "test:edge": "npm test --prefix apps/edge",
    "test:edge:workers": "npm run test:workers --prefix apps/edge",
    "build:edge": "npm run build --prefix apps/edge",
    "test:edge:db": "npm run test:db --prefix apps/edge"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "allowScripts": {
    "@swc/core": true,
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "@scarf/scarf": false,
    "tesseract.js": false,
    "@firebase/util": false
  }
}
