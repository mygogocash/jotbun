{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@mobile/*": [
        "./src/*"
      ],
      "@gogospend/contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "app",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "extends": "expo/tsconfig.base.json"
}
