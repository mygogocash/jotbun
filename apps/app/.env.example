# Copy for local dev. Production values come from the deploy platform.
EXPO_PUBLIC_API_URL=http://localhost:8090
EXPO_PUBLIC_FRONTEND_URL=http://localhost:8081

# The v1 API (`npm run dev:v1` serves it on 127.0.0.1:8091). The money
# screens use only this API; there is no fallback to the legacy /spend API.
EXPO_PUBLIC_V1_API_URL=http://localhost:8091
# Development only: 1 shows the unconverted legacy /spend screens instead.
EXPO_PUBLIC_LEGACY_SPEND=0

# Better Auth. Leave unset to use the v1 API URL above (one Worker serves both).
# EXPO_PUBLIC_AUTH_URL=
