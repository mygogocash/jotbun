{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The deletion Worker (the API's `worker:deletion`): account deletion, one
  // at a time. Secrets: ERASURE_REGISTRY_LOOKUP_KEY and the Auth0
  // maintenance client; nothing else holds the registry login.
  "name": "jotbun-deletion",
  "main": "src/roles/deletion.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 300000 },
  "vars": { "JOTBUN_ENV": "local" },
  "hyperdrive": [
    // A login in gogospend_jobs and gogospend_security.
    { "binding": "HYPERDRIVE_DELETION", "id": "00000000000000000000000000000004" },
    // A login in gogospend_erasure_registry only.
    { "binding": "HYPERDRIVE_ERASURE_REGISTRY", "id": "00000000000000000000000000000005" }
  ],
  "r2_buckets": [
    { "binding": "OBJECTS", "bucket_name": "jotbun-private-objects" }
  ],
  "queues": {
    "consumers": [{ "queue": "jotbun-deletion-jobs", "max_batch_size": 10, "max_retries": 3 }]
  },
  "triggers": { "crons": ["* * * * *"] }
}
