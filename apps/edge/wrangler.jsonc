{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jotbun-edge",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The HTTP Worker: TanStack Start pages and every /v1 route. Background work
  // runs in its own Workers (wrangler.jobs.jsonc, wrangler.security.jsonc,
  // wrangler.deletion.jsonc), each with its own logins, as the API's
  // workers are separate processes.
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "vars": {
    // Non-secret settings. Secrets (AUTH0 values, ANTHROPIC_API_KEY,
    // AUTH0_EVENTS_SIGNING_SECRETS, AUTH0_PROFILE_LINK_*) are set with
    // `wrangler secret put`. BETTER_AUTH_SECRET and ERASURE_KEY are secrets
    // too (`wrangler secret put`; locally in `.dev.vars`, Task 12).
    "JOTBUN_ENV": "local",
    "AI_ENABLED": "false",
    "GOGOCASH_BRIDGE_ENABLED": "false",
    "IMPORT_UPLOADS_ENABLED": "false",
    "AUTH_BASE_URL": "http://localhost:8092",
    "AUTH_ISSUER": "http://localhost:8092",
    "AUTH_AUDIENCE": "jotbun-v1",
    // The app scheme only. Expo dev origins stay in `.dev.vars` (M4).
    "AUTH_TRUSTED_ORIGINS": "gogospend://"
  },
  // The owner creates both databases with the `apac` location hint
  // (default pending owner Q6). The ids are local placeholders, as the
  // Hyperdrive id is.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "jotbun-auth",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/auth"
    },
    {
      "binding": "ERASURE_DB",
      "database_name": "jotbun-erasure",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/erasure"
    }
  ],
  // `remote` stays unset: setting it would reach the real Email Service from `wrangler dev`.
  "send_email": [{ "name": "EMAIL" }],
  "hyperdrive": [
    {
      // The v1 PostgreSQL 17 database through a Hyperdrive config created
      // with caching disabled (`wrangler hyperdrive create --caching-disabled`):
      // session and rate-limit reads must never come from a cache. Locally,
      // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a
      // least-privilege login (scripts/dev.mjs does), so no password is kept here.
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    { "binding": "OBJECTS", "bucket_name": "jotbun-private-objects" }
  ],
  "queues": {
    // Wake-ups only: a route that may have queued work in PostgreSQL wakes
    // that role's Worker instead of leaving it to the next Cron Trigger.
    "producers": [
      { "binding": "JOBS", "queue": "jotbun-jobs" },
      { "binding": "SECURITY_JOBS", "queue": "jotbun-security-jobs" },
      { "binding": "DELETION_JOBS", "queue": "jotbun-deletion-jobs" }
    ]
  }
}
