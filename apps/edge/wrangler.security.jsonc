{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The security Worker (the API's `worker:security`): provider cleanup after
  // a global logout or a credential change, provider links and the
  // reconciliation pass. The only Worker with the Auth0 maintenance secrets
  // (AUTH0_MAINTENANCE_CLIENT_ID/SECRET), besides deletion.
  "name": "jotbun-security",
  "main": "src/roles/security.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "JOTBUN_ENV": "local" },
  "hyperdrive": [
    // A login in gogospend_jobs and gogospend_security.
    { "binding": "HYPERDRIVE_SECURITY", "id": "00000000000000000000000000000003" }
  ],
  "queues": {
    "consumers": [{ "queue": "jotbun-security-jobs", "max_batch_size": 10, "max_retries": 3 }]
  },
  "triggers": { "crons": ["* * * * *"] }
}
