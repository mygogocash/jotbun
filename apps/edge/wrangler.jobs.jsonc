{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The jobs Worker (the API's `worker:jobs`): snapshots, exports, import
  // expiry and the sweep, plus the import parser container.
  "name": "jotbun-jobs",
  "main": "src/roles/jobs.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // A run drains the queue for up to ten minutes (src/roles/common.ts).
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "JOTBUN_ENV": "local",
    "JOB_SWEEP_INTERVAL_MINUTES": "15"
    // Secrets for the parser container: PARSER_DATABASE_URL (a gogospend_jobs
    // login reachable from the container) and R2_ENDPOINT, R2_BUCKET,
    // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY (a token for this bucket only).
  },
  "hyperdrive": [
    // A login in gogospend_jobs only (the queue and the publication registry).
    { "binding": "HYPERDRIVE_JOBS", "id": "00000000000000000000000000000001" },
    // A login in gogospend_leased_read only; never the same login.
    { "binding": "HYPERDRIVE_LEASED_READ", "id": "00000000000000000000000000000002" }
  ],
  "r2_buckets": [
    { "binding": "OBJECTS", "bucket_name": "jotbun-private-objects" }
  ],
  "queues": {
    "consumers": [{ "queue": "jotbun-jobs", "max_batch_size": 10, "max_retries": 3 }]
  },
  "triggers": {
    // Every minute: due and retried jobs; the sweep on every JOB_SWEEP_INTERVAL_MINUTES-th minute.
    "crons": ["* * * * *"]
  },
  "containers": [
    {
      // The API's release image (apps/api/Dockerfile: Node 26, the parser
      // child sandbox, libvips), started as its parse worker
      // (src/roles/parser.ts), sized at the reviewed 512 MiB parser budget;
      // one at a time.
      "class_name": "ImportParser",
      "image": "../api/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PARSER", "class_name": "ImportParser" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImportParser"] }],
  // Local runs leave parses queued unless Docker is wanted (`enable_containers`).
  "dev": { "enable_containers": false }
}
