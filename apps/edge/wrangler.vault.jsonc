{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The vault Worker: one UserVault Durable Object per person, holding that
  // person's ledger in SQLite (src/vault). It runs as its own Worker until
  // Phase 1B moves the class into the HTTP Worker. Until the HTTP front door
  // lands it answers only GET /live (src/roles/vault.ts).
  "name": "jotbun-vault",
  "main": "src/roles/vault.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "JOTBUN_ENV": "local" },
  // Published policies, gates and client minimums (config:v1). The id is a
  // local placeholder, as the Hyperdrive ids in wrangler.jsonc are.
  "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "UserVault" }]
  },
  "migrations": [{ "tag": "v1-user-vault", "new_sqlite_classes": ["UserVault"] }]
}
