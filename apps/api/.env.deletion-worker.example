# Account deletion worker (`npm run worker:deletion -w gogospend-api -- --registry-fd 3`).
# A separate process and deployment from the API and the other workers; the
# API never receives these values. See docs/operations/deletion.md.

# Pooled endpoint for a login that is a member of gogospend_jobs and
# gogospend_security only (never gogospend_app or gogospend_bootstrap).
# Non-loopback hosts always use verified TLS.
DATABASE_URL=postgres://gogospend_dev_deletion:placeholder@127.0.0.1:55432/gogospend_v1

# The erasure registry's login and lookup key are never environment
# variables: the deployment pipes {"database_url", "lookup_key"} from the
# secret manager into an inherited descriptor named by --registry-fd.

# Auth0 maintenance machine-to-machine application (the same application and
# scopes as the security worker; see docs/operations/auth0-runbook.md).
# Placeholders until E1 approval.
AUTH0_ISSUER=https://your-tenant.example.auth0.com/
# Canonical tenant domain, https and ending in "/"; defaults to AUTH0_ISSUER.
AUTH0_MANAGEMENT_URL=
# The native app clients whose refresh grants are revoked. Required.
AUTH0_ALLOWED_CLIENT_IDS=native-ios-client-id,native-android-client-id
AUTH0_MAINTENANCE_CLIENT_ID=
AUTH0_MAINTENANCE_CLIENT_SECRET=

# Private Cloudflare R2 bucket holding job output (the same bucket and scoped
# token as the job worker). Placeholders until E1 approval.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# Local development only (refused in production): keep objects in memory.
# OBJECT_STORE=memory

# Seconds between polls when the queue is empty (1-300).
DELETION_WORKER_INTERVAL_SECONDS=15

# P6b: OPERATIONAL_PAUSE=jobs stops claiming jobs (maintenance, reports and
# alert lines carry on); the job worker also honours imports (no import
# parsing). Same scope list as the API's. SIGTERM drains for at most
# SHUTDOWN_TIMEOUT_SECONDS (5-120, default 25).
OPERATIONAL_PAUSE=
SHUTDOWN_TIMEOUT_SECONDS=25
