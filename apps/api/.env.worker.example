# Security job worker (`npm run worker:security -w gogospend-api`). A separate
# process and deployment from the API: the API never receives these values.

# Pooled endpoint for a login that is a member of gogospend_jobs and
# gogospend_security only (never gogospend_app or gogospend_bootstrap).
# Non-loopback hosts always use verified TLS.
DATABASE_URL=postgres://gogospend_dev_worker:placeholder@127.0.0.1:55432/gogospend_v1

# Auth0 maintenance machine-to-machine application. Its own application, not the
# read-profile one, granted only the Management API scopes listed in
# docs/operations/auth0-runbook.md. Placeholders until E1 approval.
AUTH0_ISSUER=https://your-tenant.example.auth0.com/
# Canonical tenant domain, https and ending in "/"; defaults to AUTH0_ISSUER.
AUTH0_MANAGEMENT_URL=
# The native app clients whose refresh grants global logout revokes (same
# value as the API's AUTH0_ALLOWED_CLIENT_IDS). Required.
AUTH0_ALLOWED_CLIENT_IDS=native-ios-client-id,native-android-client-id
AUTH0_MAINTENANCE_CLIENT_ID=
AUTH0_MAINTENANCE_CLIENT_SECRET=

# Seconds between polls (1-300).
SECURITY_WORKER_INTERVAL_SECONDS=15
