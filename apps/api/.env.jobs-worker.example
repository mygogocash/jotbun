# Generic job worker (`npm run worker:jobs -w gogospend-api`). A separate
# process from the API and from the security worker; the API never receives
# these values. Neither does the import parser child it starts per upload: its
# environment is TZ=UTC only, under Node's permission model (no network).
# Size the worker's container at the reviewed 512 MiB parser budget.

# Pooled endpoint for a login that is a member of gogospend_jobs only (the
# queue and the object publication registry; no financial tables).
DATABASE_URL=postgres://gogospend_dev_jobs:placeholder@127.0.0.1:55432/gogospend_v1
# A second login, a member of gogospend_leased_read only: account reads through
# routines that validate the job's current lease. Never the same login.
LEASED_READ_DATABASE_URL=postgres://gogospend_dev_leased_read:placeholder@127.0.0.1:55432/gogospend_v1

# Private Cloudflare R2 bucket for job output (S3 API, https origin). The
# token is scoped to this bucket only. Placeholders until E1 approval.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# Local development only (refused in production): keep objects in memory.
# OBJECT_STORE=memory

# Minutes between sweeps of unpublished, expired and orphaned objects (1-1440).
JOB_SWEEP_INTERVAL_MINUTES=15
