# Copy for local dev. Production values come from the deploy platform.
PORT=8090
MONGO_URI=mongodb://localhost:27017/gogospend?replicaSet=rs0
JWT_SECRET=change-me-dev-only

# Same Firebase project as GoGoCash = SSO for existing members.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Spend access gate. Unset/empty allowlist + no product_access row = seeded Off.
SPEND_ALLOWLIST_USER_IDS=

# Salt Edge (honest-unavailable until both are set).
SALT_EDGE_APP_ID=
SALT_EDGE_SECRET=
SALT_EDGE_CALLBACK_URL=http://localhost:8090/spend/bank-link/callbacks
SALT_EDGE_CALLBACK_PUBLIC_KEY=

# Machine-to-machine auth for /internal/spend/* (account deletion, PDPA export).
INTERNAL_API_KEY=change-me-dev-only

# GoGoCash legal API base for the terms re-acceptance check. Unset = dev
# mode (check skipped with a warning); production must set it.
LEGAL_API_URL=

# Public web origin of the spend client (Salt Edge connect returnTo).
SPEND_WEB_ORIGIN=http://localhost:8081

# Import worker drain. Exactly one stack sets CRON_ENABLED=true.
CRON_ENABLED=true
