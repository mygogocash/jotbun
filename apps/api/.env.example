# Copy for local dev. Production values come from the deploy platform.

# --- v1 API (`npm run dev:v1` sets these itself for local work) ---
# Pooled endpoint for a login that is a member of gogospend_app (and
# gogospend_bootstrap for the API). Non-loopback hosts always use verified TLS;
# URL query parameters such as sslmode are ignored.
DATABASE_URL=postgres://gogospend_dev_api:placeholder@127.0.0.1:55432/gogospend_v1
DATABASE_POOL_MAX=10
# Migration-only direct endpoint, used by `npm run db:migrate`; never given to the API.
DATABASE_DIRECT_URL=postgres://gogospend_local_admin:gogospend-local-only@127.0.0.1:55432/gogospend_v1
# Auth0 (placeholders; real non-production values only after E1 approval).
# Issuer is https and ends in "/". Only API access tokens for this audience from
# these native client IDs are accepted.
AUTH0_ISSUER=https://your-tenant.example.auth0.com/
AUTH0_AUDIENCE=https://api.gogospend.example
AUTH0_ALLOWED_CLIENT_IDS=native-ios-client-id,native-android-client-id
# Read-profile machine-to-machine client (read:users only; never the maintenance
# client). Leave blank until E1: sign-in then fails closed with 503.
AUTH0_PROFILE_LINK_CLIENT_ID=
AUTH0_PROFILE_LINK_CLIENT_SECRET=
# Canonical tenant domain for the Management API, https and ending in "/";
# defaults to AUTH0_ISSUER (set this when the issuer is a custom domain).
AUTH0_MANAGEMENT_URL=
# Required, at least 32 random characters (e.g. `openssl rand -base64 48`); keys the hashed
# rate-limit buckets. Left empty here so a copied example cannot start with a known key.
RATE_LIMIT_KEY=
# Oldest app builds still served; older ones get 426 CLIENT_UPGRADE_REQUIRED.
MIN_CLIENT_VERSION_IOS=0.0.0
MIN_CLIENT_VERSION_ANDROID=0.0.0
# Reverse proxies allowed to set X-Forwarded-For (Railway: 1). 0 locally.
TRUST_PROXY_HOPS=0

# --- legacy API (`npm run dev`) ---
PORT=8090
MONGO_URI=mongodb://localhost:27017/gogospend?replicaSet=rs0
JWT_SECRET=change-me-dev-only

# Same Firebase project as GoGoCash = SSO for existing members.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Spend access gate. Unset/empty allowlist + no product_access row = seeded Off.
SPEND_ALLOWLIST_USER_IDS=

# Salt Edge (honest-unavailable until both are set).
SALT_EDGE_APP_ID=
SALT_EDGE_SECRET=
SALT_EDGE_CALLBACK_URL=http://localhost:8090/spend/bank-link/callbacks
SALT_EDGE_CALLBACK_PUBLIC_KEY=

# Machine-to-machine auth for /internal/spend/* (account deletion, PDPA export).
INTERNAL_API_KEY=change-me-dev-only

# GoGoCash legal API base for the terms re-acceptance check. Unset = dev
# mode (check skipped with a warning); production must set it.
LEGAL_API_URL=

# Public web origin of the spend client (Salt Edge connect returnTo).
SPEND_WEB_ORIGIN=http://localhost:8081

# Import worker drain. Exactly one stack sets CRON_ENABLED=true.
CRON_ENABLED=true
