{
  "expo": {
    "name": "Jotbun",
    "slug": "gogospend",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gogospend",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "package": "co.gogocash.spend",
      "adaptiveIcon": { "backgroundColor": "#ffffff" },
      "allowBackup": false
    },
    "plugins": ["expo-router", "expo-secure-store", ["expo-sqlite", { "useSQLCipher": true }], "expo-document-picker"],
    "experiments": { "typedRoutes": true }
  }
}
