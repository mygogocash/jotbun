+    const token = randomUUID()
+    expect(await stepCall(user, 'imports.begin', beginBody(jobId, token), { charge: 'write' })).toMatchObject({ ok: true, body: { kind: 'started' } })
+    const first = await stepCall(user, 'imports.reservePart', { job_id: jobId, intake_token: token, index: 0 })
+    expect(first).toMatchObject({ ok: true })
+    expect((await v1.as(user).post('/v1/me/logout')).status).toBe(204)
+    // As the API's begin and finish under the account lock: an ended session starts and finishes nothing.
+    expect(await stepCall(user, 'imports.begin', beginBody(randomUUID(), randomUUID()), { charge: 'write' })).toMatchObject({ ok: false, status: 401, code: 'SESSION_REQUIRED' })
+    const second = await stepCall(user, 'imports.reservePart', { job_id: jobId, intake_token: token, index: 1 })
+    expect(second).toMatchObject({ ok: true })
+    const keys = [keyOf(first), keyOf(second)]
