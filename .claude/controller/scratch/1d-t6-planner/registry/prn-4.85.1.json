{
  "name": "posthog-react-native",
  "version": "4.85.1",
  "dependencies": {
    "@posthog/core": "^1.62.0",
    "@posthog/types": "^1.419.0"
  },
  "peerDependencies": {
    "expo-device": ">= 4.0.0",
    "expo-updates": ">= 0.25.0",
    "expo-application": ">= 4.0.0",
    "expo-file-system": ">= 13.0.0",
    "react-native-svg": ">= 15.0.0",
    "expo-localization": ">= 11.0.0",
    "react-native-localize": ">= 3.0.0",
    "react-native-navigation": ">= 6.0.0",
    "@react-navigation/native": ">= 5.0.0",
    "react-native-device-info": ">= 10.0.0",
    "@posthog/react-native-plugin": ">= 2.12.7",
    "react-native-safe-area-context": ">= 4.0.0",
    "posthog-react-native-session-replay": ">= 1.6.0",
    "@react-native-async-storage/async-storage": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "expo-device": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "expo-localization": {
      "optional": true
    },
    "react-native-localize": {
      "optional": true
    },
    "react-native-navigation": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    },
    "@posthog/react-native-plugin": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "posthog-react-native-session-replay": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "scripts": {
    "lint": "oxlint --report-unused-disable-directives-severity error src test",
    "test": "pnpm test:unit",
    "build": "tsc -b && babel ./dist --out-dir dist --extensions '.js' --source-maps",
    "clean": "rimraf dist",
    "package": "pnpm pack --out $PACKAGE_DEST/%s.tgz",
    "lint:fix": "oxlint --report-unused-disable-directives-severity error src test --fix",
    "prebuild": "node ../../tooling/write-version.mjs",
    "test:unit": "vitest run",
    "test:built": "node --test scripts/check-sourcemaps.mjs",
    "check-types": "pnpm prebuild && tsc --noEmit --project tsconfig.json",
    "generate-references": "pnpm exec api-extractor run --config ./api-extractor.json --local && node scripts/generate-docs.cjs"
  },
  "dist-tags": {
    "alpha": "3.0.0-beta.3",
    "previous": "4.12.6",
    "latest": "4.85.3"
  },
  "license": "MIT",
  "dist.attestations.provenance": {
    "predicateType": "https://slsa.dev/provenance/v1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/tooling/expoconfig.d.ts",
      "default": "./dist/tooling/expoconfig.js"
    },
    "./metro": {
      "types": "./dist/tooling/metroconfig.d.ts",
      "default": "./dist/tooling/metroconfig.js"
    }
  }
}
