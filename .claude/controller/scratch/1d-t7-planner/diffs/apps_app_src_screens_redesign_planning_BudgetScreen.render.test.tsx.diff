+// ---------------------------------------------------------------------------
+// Analytics (1D-T7, R61)
+
+test("saving the month's budget records one budget_set, without the amount", async () => {
+  const recorded = await recordAnalytics();
+  try {
+    const fake = await toLimits('18000');
+    fake.loseResponse('setBudget');
+    save();
+    expect(await screen.findByText(UNCONFIRMED)).toBeTruthy();
+    const captured = () => recorded.sent.filter((event) => event.kind === 'capture').map(({ name, properties }) => ({ name, properties }));
+    expect(captured()).toEqual([]);
+    click('Try again');
+    expect(await screen.findByText('Budget saved')).toBeTruthy();
+    expect(captured()).toEqual([{ name: 'budget_set', properties: { budget: 'set', origin: 'app' } }]);
+    const json = JSON.stringify(recorded.sent);
+    for (const secret of ['1800000', '18000', '18,000']) expect(json).not.toContain(secret);
+  } finally {
+    recorded.restore();
+  }
+});
+
+test('a budget Jotbun already holds with exactly these figures records one budget_set; different figures record none', async () => {
+  const recorded = await recordAnalytics();
+  try {
+    const captured = () => recorded.sent.filter((event) => event.kind === 'capture').map(({ name }) => name);
+    const theirs = await toLimits('18000');
+    theirs.budgets.set(SEPT, septBudget('1500000', []));
+    save();
+    await screen.findByTestId('budget-conflict');
+    expect(captured()).toEqual([]);
+    cleanup();
+    const same = await toLimits('18000');
+    same.budgets.set(SEPT, { ...septBudget('1800000', []), id: '0000000d-0000-4000-8000-0000000000b2' });
+    save();
+    expect(await screen.findByText('Budget saved')).toBeTruthy();
+    expect(captured()).toEqual(['budget_set']);
+  } finally {
+    recorded.restore();
+  }
+});
