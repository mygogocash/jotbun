+test('monthName gives short and long names in Thai and English', () => {
+  assert.deepEqual([monthName('2026-10', 'th', 'short'), monthName('2026-10', 'th', 'long')], ['ต.ค.', 'ตุลาคม']);
+  assert.deepEqual([monthName('2026-10', 'en', 'short'), monthName('2026-10', 'en', 'long')], ['Oct', 'October']);
+  assert.deepEqual([monthName('2026-11', 'th', 'short'), monthName('2027-01', 'th', 'long'), monthName('2026-12', 'en', 'short')], ['พ.ย.', 'มกราคม', 'Dec']);
+  assert.deepEqual([monthName('2026-10', 'vi', 'short'), monthName('2026-10', 'vi', 'long')], ['thg 10', 'tháng 10']);
+  for (const bad of ['2026-13', '2026-00', '0000-10', '2026-10-01']) {
+    assert.throws(() => monthName(bad, 'en', 'long'), { name: 'TypeError', message: `Expected a YYYY-MM month, got ${bad}.` }, bad);
+  }
+});
