+      said,
+      [said],
+    ]);
+    // No digit of it anywhere: drawn, in its words, or said (Review Focus 2).
+    expect([text('add-save-problem'), label('add-save-problem'), ...announce.mock.calls.map(([each]) => each)].join(' '), locale).not.toMatch(/\p{Nd}/u);
+    cleanup();
+  }
+});
