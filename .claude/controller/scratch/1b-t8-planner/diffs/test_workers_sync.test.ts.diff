+/** One food expense in the wallet, through the route. */
+async function record(user: TestUser, wallet: string, amount: string, note: string | null = null): Promise<void> {
+  const food = derivedUuid(user.sub, 'builtin-category', 'food')
+  const res = await client.as(user).post('/v1/transactions', { id: randomUUID(), type: 'expense', amount_minor: amount, occurred_on: '2026-03-02', wallet_id: wallet, category_id: food, note })
+  expect(res.status).toBe(201)
+}
+
+/** The API spec's diary: a member with the built-in categories, a Cash wallet and one coffee. */
+async function diary(): Promise<{ user: TestUser; wallet: string }> {
+  const user = await member(client)
+  expect((await client.as(user).post('/v1/categories/builtins')).status).toBe(200)
+  const wallet = await createWallet(user, 'Cash')
+  await record(user, wallet, '6500', 'coffee')
+  return { user, wallet }
+}
+
+/** POST /v1/sync/snapshots, then SnapshotWorkflow's run to its end (1B-T8): the snapshot's id. */
+async function builtSnapshot(user: TestUser): Promise<string> {
+  const key = randomUUID()
+  const id = derivedUuid(user.sub, 'snapshot-request', key)
+  const instance = await introspectWorkflowInstance(env.SNAPSHOT_WORKFLOW, id)
+  try {
+    expect((await client.as(user).post('/v1/sync/snapshots', {}, { key })).status).toBe(202)
+    await client.settle()
+    expect(await startedOf(user, id)).toEqual([{ started: 1 }])
+    await instance.waitForStatus('complete')
+  } finally {
+    await instance.dispose()
+  }
+  return id
+}
+
+/** Whether the front door's hand-off started the snapshot: its row is marked once its Workflow instance exists. */
+const startedOf = (user: TestUser, id: string) => sqlRows<{ started: number }>(user, 'SELECT started_at IS NOT NULL AS started FROM snapshots WHERE id = ?', id)
