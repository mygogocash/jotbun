@@ -0,0 +1,35 @@
+// Where the wallet shell's bar shows, the inset a screen keeps under it, and
+// what /spend/add's link asks the add tray (P2-T18; shellRoutes.ts).
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { addRequestOf, WALLET_TAB_INSET, WALLET_TAB_INSET_LARGE, walletTab, walletTabInset } from './shellRoutes.ts';
+
+test('the bar shows on /spend and /spend/insights only, selecting their tab', () => {
+  assert.deepEqual(walletTab('/spend'), { visible: true, active: 'wallets' });
+  assert.deepEqual(walletTab('/spend/'), { visible: true, active: 'wallets' });
+  assert.deepEqual(walletTab('/spend/insights'), { visible: true, active: 'insights' });
+  assert.deepEqual(walletTab('/spend/insights/'), { visible: true, active: 'insights' });
+  for (const hidden of ['/spend/all', '/spend/wallet/x', '/spend/wallets', '/spend/record/x', '/spend/setup', '/spend/budget', '/spend/add', '/spend/insights/x', '/spend/recap/2026-10', '/settings', '/']) {
+    assert.deepEqual(walletTab(hidden), { visible: false, active: null }, hidden);
+  }
+});
+
+test('a screen keeps 84 pt clear of the + under the bar, 96 pt at the largest text sizes, and nothing where the bar is hidden', () => {
+  assert.equal(WALLET_TAB_INSET, 84);
+  assert.equal(WALLET_TAB_INSET_LARGE, 96);
+  assert.equal(walletTabInset(true, false), 84);
+  assert.equal(walletTabInset(true, true), 96);
+  assert.equal(walletTabInset(false, false), 0);
+  assert.equal(walletTabInset(false, true), 0);
+});
+
+test("/spend/add's link asks for a known type, a wallet and a record to copy, each only when named", () => {
+  assert.deepEqual(addRequestOf({}), {});
+  for (const type of ['expense', 'income', 'transfer']) assert.deepEqual(addRequestOf({ type }), { type });
+  assert.deepEqual(addRequestOf({ type: 'refund' }), {});
+  assert.deepEqual(addRequestOf({ type: ['income'] }), {});
+  assert.deepEqual(addRequestOf({ walletId: 'w1', copyOf: 'r1', amount: '5000' }), { walletId: 'w1', copyOf: 'r1' });
+  assert.deepEqual(addRequestOf({ type: 'transfer', walletId: 'w1' }), { type: 'transfer', walletId: 'w1' });
+  assert.deepEqual(addRequestOf({ walletId: '', copyOf: ['r1', 'r2'] }), {});
+});
diff --git a/apps/app/src/wallet/home/spendLayoutOrder.test.ts b/apps/app/src/wallet/home/spendLayoutOrder.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f545e3eebe71b59fde6d9337e0b19992db1c9b01
--- /dev/null
+++ b/apps/app/src/wallet/home/spendLayoutOrder.test.ts
@@ -0,0 +1,98 @@
+// The spend layout's order (P2-T18; R58, R82, W34). app/spend/_layout.tsx's
+// wallet branch nests the device diary, Bun's AI help, the wallet shell,
+// History's keep and the screen, in that order. It comes after the sign-in
+// redirect and the legacy build, and before the core branch. When the file
+// holds 1C's terms gate, the gate sits between the diary and
+// CompanionBoundary in this branch too; when it holds 1D-T8's consent
+// question, the question takes the whole shell's place inside
+// CompanionBoundary, on the layout's own condition. So a clean parallel merge
+// cannot drop either from this branch. The app mounts one add tray host: the
+// shell's (the catalogue's sections may mount their own).
+import assert from 'node:assert/strict';
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { dirname, join, relative, sep } from 'node:path';
+import { test } from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+const appRoot = join(dirname(fileURLToPath(import.meta.url)), '..', '..', '..');
+const layout = () => readFileSync(join(appRoot, 'app', 'spend', '_layout.tsx'), 'utf8');
+const WALLET_BRANCH = "if (isRedesignEnabled('wallet'))";
+
+/** The wallet branch: from its condition to the end of its one statement (its JSX holds no semicolon). */
+function walletBranch(source: string): string {
+  const start = source.indexOf(WALLET_BRANCH);
+  assert.ok(start >= 0, 'the layout has a wallet branch');
+  const end = source.indexOf(';', start);
+  assert.ok(end > start, 'the wallet branch ends');
+  return source.slice(start, end);
+}
+
+/** Every marker is in `text`, each first found after the one before. */
+function inOrder(text: string, markers: readonly string[]): void {
+  const at = markers.map((marker) => text.indexOf(marker));
+  assert.deepEqual(markers.filter((_, index) => at[index] < 0), [], 'every marker is there');
+  for (let index = 1; index < markers.length; index += 1) {
+    assert.ok(at[index - 1] < at[index], `${markers[index - 1]} comes before ${markers[index]}`);
+  }
+}
+
+test('the wallet branch nests the diary, the companion, the shell, History\'s keep and the slot in that order', () => {
+  const source = layout();
+  const branch = walletBranch(source);
+  inOrder(branch, ['<DeviceDiaryProvider>', '<CompanionBoundary>', '<WalletShell>', '<HistoryKeepProvider>', '<Slot />']);
+  inOrder(branch, ['<Slot />', '</HistoryKeepProvider>', '</WalletShell>', '</CompanionBoundary>', '</DeviceDiaryProvider>']);
+  if (source.includes('<TermsGate')) inOrder(branch, ['<DeviceDiaryProvider>', '<TermsGate', '<CompanionBoundary>']);
+  if (source.includes('<AnalyticsConsentScreen')) inOrder(branch, ['<CompanionBoundary>', '<AnalyticsConsentScreen', '<WalletShell>']);
+});
+
+test('the wallet branch comes after the sign-in redirect and the legacy build, and before the core branch', () => {
+  const source = layout();
+  inOrder(source, ['<Redirect href="/login" />', 'if (isLegacySpendEnabled())', WALLET_BRANCH, "isRedesignEnabled('core')"]);
+});
+
+test("the consent question takes the shell's place inside CompanionBoundary", () => {
+  const branch = walletBranch(layout());
+  const question = branch.indexOf('<AnalyticsConsentScreen');
+  assert.ok(question > branch.indexOf('<CompanionBoundary>'), 'after CompanionBoundary opens');
+  assert.ok(question < branch.indexOf('</CompanionBoundary>'), 'before CompanionBoundary closes');
+  assert.ok(question < branch.indexOf('<WalletShell>') || question > branch.indexOf('</WalletShell>'), 'never inside the shell');
+  // On the layout's own condition, which the core branch reads too (one condition, 1D-T8's `ask`).
+  assert.ok(branch.includes('{ask ? <AnalyticsConsentScreen /> : <WalletShell>'), 'ask chooses between the question and the shell');
+});
+
+test("the shell nests the shared resources, the looks, the card frames, the toast's host and the add tray's host around its root, in that order", () => {
+  const shell = readFileSync(join(appRoot, 'src', 'wallet', 'home', 'WalletShell.tsx'), 'utf8');
+  inOrder(shell, [
+    '<SpendV1Provider resources={getSharedV1Resources()}>',
+    '<WalletLooksProvider>',
+    '<CardFramesProvider>',
+    '<SavedToastHost>',
+    '<ShellTray>',
+    '</SavedToastHost>',
+    '</CardFramesProvider>',
+    '</WalletLooksProvider>',
+    '</SpendV1Provider>',
+    'const toast = useSavedToast();',
+    '<AddTrayHost onSaved={onSaved} blocked={blocked}>',
+    '<ShellFrame blocked={blocked}>',
+    '</AddTrayHost>',
+    '<View testID="wallet-shell"',
+  ]);
+});
+
+/** Every source file under apps/app's app/ and src/, but tests, test helpers and the development catalogue. */
+function appSources(dir: string): string[] {
+  return readdirSync(dir).flatMap((name) => {
+    const path = join(dir, name);
+    if (statSync(path).isDirectory()) return name === 'node_modules' ? [] : appSources(path);
+    return /\.tsx?$/.test(name) && !/\.test\.tsx?$/.test(name) ? [path] : [];
+  });
+}
+
+test('the app mounts one add tray host for its life: the wallet shell\'s', () => {
+  const mounts = [...appSources(join(appRoot, 'app')), ...appSources(join(appRoot, 'src'))]
+    .map((path) => relative(appRoot, path).split(sep).join('/'))
+    .filter((path) => !path.startsWith('src/dev/catalogue/') && !path.includes('/testing/'))
+    .flatMap((path) => readFileSync(join(appRoot, path), 'utf8').match(/<AddTrayHost\b/g)?.map(() => path) ?? []);
+  assert.deepEqual(mounts, ['src/wallet/home/WalletShell.tsx']);
+});
diff --git a/apps/app/src/wallet/home/WalletTabBar.tsx b/apps/app/src/wallet/home/WalletTabBar.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0c8a79fc5a06fce2e458018432692288dc56c9e2
--- /dev/null
+++ b/apps/app/src/wallet/home/WalletTabBar.tsx
@@ -0,0 +1,122 @@
+// The wallet shell's bar (P2-T18; bw-home, dk-home, W13, ax-voiceover,
+// ax-large-home rule 8): กระเป๋า (/spend) and สรุป (/spend/insights) are
+// tabs, and ฉัน is a link to Settings, which sits outside the shell, so it is
+// never selected. Each item says its place (1 จาก 3, 2 จาก 3, 3 จาก 3) and is
+// at least 44 pt in its own box. The labels stop at iOS's largest standard
+// size, as Apple's own bars do; at the largest text sizes they hide, the icons
+// grow to 30 pt and each item keeps its name, which a long press shows large
+// (iOS's large content viewer). The bar is a row of the layout under the
+// screen (shellRoutes.ts); useWalletTabInset is what a screen keeps clear.
+import { usePathname, useRouter } from 'expo-router';
+import { Pressable, View } from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import Svg, { Circle, Path, Rect } from 'react-native-svg';
+
+import { useWalletColors } from '@mobile/theme/ThemeProvider';
+import { DECORATIVE } from '@mobile/ui/a11y';
+import { useLargeText } from '@mobile/ui/largeText';
+import { LARGEST_STANDARD_SCALE } from '@mobile/ui/largeTextScale';
+import { useDraftCopy } from '../copy/useDraftCopy';
+import { WalletText } from '../WalletText';
+import { COPY } from './copy';
+import { WALLET_TAB_ROUTES, walletTab, walletTabInset } from './shellRoutes';
+import type { WalletTabKey } from './shellRoutes';
+
+type ItemKey = WalletTabKey | 'me';
+
+/** The bar's items in order: each one's name and its place. */
+const ITEMS: readonly { key: ItemKey; name: string; place: number }[] = [
+  { key: 'wallets', name: 'home.tabWallets', place: 1 },
+  { key: 'insights', name: 'home.tabInsights', place: 2 },
+  { key: 'me', name: 'home.tabMe', place: 3 },
+];
+
+/** A screen's bottom inset: what keeps its last row clear of the +, or 0 where the bar is hidden. */
+export function useWalletTabInset(): number {
+  const pathname = usePathname();
+  const large = useLargeText();
+  return walletTabInset(walletTab(pathname).visible, large);
+}
+
+/** bw-home's line drawings, in the colour of the item; decorative, since each item says its name. */
+function TabIcon({ item, color, ground, size }: { item: ItemKey; color: string; ground: string; size: number }) {
+  return (
+    <Svg width={size} height={size} viewBox="0 0 24 24">
+      {item === 'wallets' ? (
+        <>
+          <Rect x={3} y={6} width={18} height={13} rx={3} fill={color} />
+          <Path d="M3 10h18" stroke={ground} strokeWidth={2} />
+        </>
+      ) : item === 'insights' ? (
+        <Path d="M5 20V11M12 20V5M19 20v-6" fill="none" stroke={color} strokeWidth={2.2} strokeLinecap="round" />
+      ) : (
+        <>
+          <Circle cx={12} cy={8} r={4} fill="none" stroke={color} strokeWidth={2} />
+          <Path d="M4 21c1-4 4-6 8-6s7 2 8 6" fill="none" stroke={color} strokeWidth={2} strokeLinecap="round" />
+        </>
+      )}
+    </Svg>
+  );
+}
+
+export function WalletTabBar() {
+  const pathname = usePathname();
+  const router = useRouter();
+  const colors = useWalletColors();
+  const insets = useSafeAreaInsets();
+  const large = useLargeText();
+  const t = useDraftCopy(COPY);
+  const { active } = walletTab(pathname);
+  const go = (item: ItemKey) => {
+    if (item === 'me') router.push('/settings');
+    else if (item !== active) router.navigate(WALLET_TAB_ROUTES[item]);
+  };
+  return (
+    <View
+      testID="wallet-tab-bar"
+      role="tablist"
+      accessibilityRole="tablist"
+      style={{
+        flexDirection: 'row',
+        justifyContent: 'space-around',
+        alignItems: 'center',
+        paddingTop: 6,
+        paddingBottom: Math.max(insets.bottom, 6),
+        borderTopWidth: 1,
+        borderTopColor: colors.hairline,
+        backgroundColor: colors.ground,
+      }}
+    >
+      {ITEMS.map((item) => {
+        const tab = item.key !== 'me';
+        const selected = tab && item.key === active;
+        const name = t(item.name);
+        const color = selected ? colors.ink : colors.quietOnGround;
+        return (
+          <Pressable
+            key={item.key}
+            testID={`wallet-tab-${item.key}`}
+            role={tab ? 'tab' : 'link'}
+            accessibilityRole={tab ? 'tab' : 'link'}
+            accessibilityLabel={name}
+            aria-valuetext={t('home.tabPlace', { n: item.place })}
+            {...(tab ? { accessibilityState: { selected }, 'aria-selected': selected } : {})}
+            accessibilityShowsLargeContentViewer
+            accessibilityLargeContentTitle={name}
+            onPress={() => go(item.key)}
+            style={{ minHeight: large ? 52 : 44, minWidth: large ? 64 : 56, alignItems: 'center', justifyContent: 'center', gap: 2 }}
+          >
+            <View {...DECORATIVE}>
+              <TabIcon item={item.key} color={color} ground={colors.ground} size={large ? 30 : 24} />
+            </View>
+            {large ? null : (
+              <WalletText role="caption" tone={selected ? 'ink' : 'quietOnGround'} maxFontSizeMultiplier={LARGEST_STANDARD_SCALE} style={{ fontSize: 11, fontWeight: selected ? '700' : '400' }}>
+                {name}
+              </WalletText>
+            )}
+          </Pressable>
+        );
+      })}
+    </View>
+  );
+}
diff --git a/apps/app/src/wallet/home/AddButton.tsx b/apps/app/src/wallet/home/AddButton.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d46a8824fabe3c9ed53b5eedcf69a6ba2c3e54f0
