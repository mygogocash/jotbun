+test("today's money out leaves out a command Jotbun acknowledged at or before the read's revision: the read saw it deleted", () => {
+  // Each call through one helper, so a throw is an answer to compare, never the end of the case.
+  const out = (outbox: OutboxCommand[], readRevision?: string) => {
+    try {
+      return todayOutMinor({ summaryExpenseMinor: '8200', confirmedIds: new Set(), outbox, today: TODAY, ...(readRevision === undefined ? {} : { readRevision }) });
+    } catch (error) {
+      return `threw ${(error as Error).name}`;
+    }
+  };
+  const acked = (revision: string | null) => own('acknowledged', { ackedRevision: revision });
+  assert.deepEqual([
+    // Committed at the read's revision or before it (9 is before 10, as numbers), and not listed: deleted since.
+    out([acked('10')], '10'),
+    out([acked('9')], '10'),
+    // Committed after the read: not in its total yet, so counted.
+    out([acked('11')], '10'),
+    // With no read revision, or no committed revision, it counts as before.
+    out([acked('9')]),
+    out([acked(null)], '10'),
+    // Only an acknowledged command was committed: one being sent is counted whatever its revision says.
+    out([own('sending', { ackedRevision: '9' })], '10'),
+  ], ['8200', '8200', '13200', '13200', '13200', '13200']);
+});
+
