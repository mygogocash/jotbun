diff --git a/apps/app/src/dev/catalogue/wallet/savedScreens.tsx b/apps/app/src/dev/catalogue/wallet/savedScreens.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0e08327889fdec56e50cdaef0dd2f2d86761e625
--- /dev/null
+++ b/apps/app/src/dev/catalogue/wallet/savedScreens.tsx
@@ -0,0 +1,150 @@
+// The saved moment's catalogue states (P2-T17, development only), loaded by
+// ./savedSections.tsx when a section opens: the real SavedToastHost on the
+// catalogue's fakes (screenSection's stage), over a page that names the state.
+// The page shows the state's notice once as the section opens, as the wallet
+// shell does from the add tray's onSaved (P2-T18); Show again shows it again.
+//
+// - The host reads today's spending for the real today, so the fakes hold it:
+//   ฿132 spent earlier today and the ฿50 just saved online, which make
+//   bw-saved's ฿182.
+// - Offline (rh-offline), the ฿50 is a draft on this phone, never sent, and
+//   the diary's last sync did not end synced: the toast says so, reads
+//   nothing, and offers Undo.
+// - Private mode is the section's own, over a store kept in memory, as
+//   kitSections.tsx shows it, so the catalogue never changes the person's own
+//   setting; the other states follow the private mode around them.
+// - After Undo: the script presses Undo, which deletes the online save at
+//   version 1, so it waits in Recently deleted.
+// No card is on this page, so nothing travels (SaveFlight). The sample words
+// are catalogue samples, not app copy.
+import { useEffect, useState } from 'react';
+import type { ReactNode } from 'react';
+import { View } from 'react-native';
+
+import { todayInBangkok } from '@mobile/spend/v1/viewModels';
+import type { SyncOutcome } from '@mobile/sync/types';
+import { BUN_SPACE } from '@mobile/ui/layout';
+import type { DraftTable } from '@mobile/wallet/copy/draftText';
+import { useDraftCopy } from '@mobile/wallet/copy/useDraftCopy';
+import { PRIVATE_MODE_NAME, PrivateModeProvider } from '@mobile/wallet/privacy/PrivateModeProvider';
+import type { SavedNotice } from '@mobile/wallet/saved/savedMoment';
+import { SavedToastHost, useSavedToast } from '@mobile/wallet/saved/SavedToastHost';
+import type { KeyValueStore } from '@mobile/wallet/store/walletStore';
+import { TextLink } from '@mobile/wallet/tray/TextLink';
+import { WalletText } from '@mobile/wallet/WalletText';
+import { SpecimenLabel } from '../parts';
+import type { CatalogueSection } from '../registry';
+import { deviceDiary, draftEntry, expense, GOLDEN, goldenFake, queued } from '../screenFixtures';
+import { screenSection } from '../screenSection';
+import type { ScreenFixture, ScriptStep } from '../screenSection';
+import { WALLET_SAVED_TITLES } from './savedSections';
+import type { WalletSavedId } from './savedSections';
+
+const SAMPLES = {
+  'sample.hello': { th: 'สวัสดี', en: 'Hello' },
+  'sample.again': { th: 'แสดงอีกครั้ง', en: 'Show again' },
+} as const satisfies DraftTable;
+
+/** The ฿50 just saved, and the ฿132 spent earlier today. */
+const SAVED = expense(950, '2000-01-01', '5000');
+const EARLIER = expense(951, '2000-01-01', '13200');
+/** The diary's last sync backed off: not synced, so a save stays on this phone. */
+const OFFLINE: SyncOutcome = { status: 'waiting', progress: { sent: 0, total: 1 }, nextAttemptAt: null, uncertain: 0, needsReview: 0 };
+
+type SavedFixture = ScreenFixture & { readonly notice: SavedNotice };
+
+/** The ฿50 of chicken rice from cash, as the add tray's onSaved hands it on. */
+function notice(overrides: Partial<SavedNotice> = {}): SavedNotice {
+  return { recordId: SAVED.id, commandId: '0000000f-0000-4000-8000-000000000950', kind: 'expense', title: 'ข้าวมันไก่', walletId: GOLDEN.cash.id, via: 'online', amountMinor: '5000', offline: false, ...overrides };
+}
+
+/** Online, on the golden fakes with today's two expenses: the toast reads ฿182. */
+function online(): SavedFixture {
+  const today = todayInBangkok(new Date());
+  return { resources: goldenFake([{ ...EARLIER, occurred_on: today }, { ...SAVED, occurred_on: today }]).resources, diary: null, notice: notice() };
+}
+
+/** Kept on this phone, never sent, with the diary's last sync not synced. */
+function offline(): SavedFixture {
+  const today = todayInBangkok(new Date());
+  const command = queued(draftEntry({ id: SAVED.id, amount_minor: '5000', occurred_on: today, merchant: 'ข้าวมันไก่' }), 'unsent');
+  const diary = deviceDiary({ outbox: [command], pending: [command.payload], outcome: OFFLINE });
+  return { resources: goldenFake().resources, diary: diary.diary, notice: notice({ commandId: command.commandId, via: 'device', offline: true }) };
+}
+
+function memoryStore(seed: Readonly<Record<string, string>>): KeyValueStore {
+  const kept = new Map(Object.entries(seed));
+  return {
+    get: async (name) => kept.get(name) ?? null,
+    set: async (name, value) => { kept.set(name, value); },
+    remove: async (name) => { kept.delete(name); },
+    eraseAll: async () => { kept.clear(); },
+  };
+}
+
+/** Private mode on for this section only. */
+function Private({ children }: { children: ReactNode }) {
+  const [store] = useState(() => memoryStore({ [PRIVATE_MODE_NAME]: '1' }));
+  return <PrivateModeProvider store={store}>{children}</PrivateModeProvider>;
+}
+
+/** The page under the toast: it shows the notice once as it opens, and again on Show again. */
+function Page({ label, notice: shown }: { label: string; notice: SavedNotice }) {
+  const t = useDraftCopy(SAMPLES);
+  const { show } = useSavedToast();
+  // Once, as the section opens.
+  useEffect(() => {
+    show(shown);
+  }, []);
+  return (
+    <View style={{ flex: 1, gap: BUN_SPACE.xs, alignItems: 'flex-start', paddingHorizontal: BUN_SPACE.md, paddingTop: 96 }}>
+      <WalletText role="h1" accessibilityRole="header">{t('sample.hello')}</WalletText>
+      <SpecimenLabel>{label}</SpecimenLabel>
+      <TextLink label={t('sample.again')} onPress={() => show(shown)} />
+    </View>
+  );
+}
+
+const toast = (label: string) => (fixture: SavedFixture) => (
+  <SavedToastHost>
+    <Page label={label} notice={fixture.notice} />
+  </SavedToastHost>
+);
+const shown = (): ScriptStep[] => [{ waitFor: 'saved-toast' }];
+
+const SECTIONS: Readonly<Record<WalletSavedId, CatalogueSection>> = {
+  'bw-saved-toast': screenSection({
+    id: 'bw-saved-toast',
+    title: WALLET_SAVED_TITLES['bw-saved-toast'],
+    fixture: online,
+    script: shown,
+    render: toast("bw-saved: ฿50 saved online; today's money out (฿182), Undo, and a neutral check"),
+  }),
+  'bw-saved-offline': screenSection({
+    id: 'bw-saved-offline',
+    title: WALLET_SAVED_TITLES['bw-saved-offline'],
+    fixture: offline,
+    script: shown,
+    render: toast('rh-offline: ฿50 kept on this phone while offline, with Undo, and no total'),
+  }),
+  'bw-saved-private': screenSection({
+    id: 'bw-saved-private',
+    title: WALLET_SAVED_TITLES['bw-saved-private'],
+    fixture: online,
+    script: shown,
+    render: (fixture) => <Private>{toast("Private mode: today's money out masked, said to be hidden")(fixture)}</Private>,
+  }),
+  'bw-saved-undone': screenSection({
+    id: 'bw-saved-undone',
+    title: WALLET_SAVED_TITLES['bw-saved-undone'],
+    fixture: online,
+    // Undo is the toast's toastLink, whatever the language.
+    script: () => [{ waitFor: 'saved-toast' }, { call: 'onPress', on: { tone: 'toastLink' } }, { waitFor: 'saved-said' }],
+    render: toast('After Undo: the online save is deleted, and waits 30 days in Recently deleted'),
+  }),
+};
+
+/** One saved-moment state, drawn as the catalogue draws every screen section. */
+export default function SavedScreenSection({ id }: { id: WalletSavedId }) {
+  return <>{SECTIONS[id].render()}</>;
+}
diff --git a/apps/app/src/dev/catalogue/wallet/savedSections.tsx b/apps/app/src/dev/catalogue/wallet/savedSections.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b021ee8beb06d3a191a30cb9eb8ab43f93f8c12f
--- /dev/null
+++ b/apps/app/src/dev/catalogue/wallet/savedSections.tsx
@@ -0,0 +1,46 @@
+// The saved moment in the catalogue (P2-T17, development only): the real
+// toast host on fakes, one section per state for E2-B: today's total with Undo
+// (bw-saved), kept on this phone while offline (rh-offline), private mode, and
+// after Undo.
+//
+// The host, its fakes and the page under it are in ./savedScreens.tsx, loaded
+// when a section opens: the host reaches Quick add's command keys (and so
+// expo-crypto), which no catalogue list may load (the controller's rule, as
+// ./recapSections.tsx loads its screen). While that module loads, a section
+// reads `catalogue-screen-running`, so the catalogue waits for it as it waits
+// for a screen's script (screenSection.tsx). A section never imports the
+// wallet test harness, which loads vitest.
+import { lazy, Suspense } from 'react';
+import { View } from 'react-native';
+
+import type { CatalogueSection } from '../registry';
+
+/** The saved moment's states, in the order the catalogue steps through them. */
+export const WALLET_SAVED_IDS = ['bw-saved-toast', 'bw-saved-offline', 'bw-saved-private', 'bw-saved-undone'] as const;
+export type WalletSavedId = (typeof WALLET_SAVED_IDS)[number];
+
+export const WALLET_SAVED_TITLES: Readonly<Record<WalletSavedId, string>> = {
+  'bw-saved-toast': 'Bun Wallet: Saved toast',
+  'bw-saved-offline': 'Bun Wallet: Saved toast, offline',
+  'bw-saved-private': 'Bun Wallet: Saved toast, private mode',
+  'bw-saved-undone': 'Bun Wallet: Saved toast, undone',
+};
+
+const SavedScreenSection = lazy(() => import('./savedScreens'));
+
+/** What the catalogue meets while the host's module loads. */
+function Loading() {
+  return <View testID="catalogue-screen-running" style={{ flex: 1 }} />;
+}
+
+export const WALLET_SAVED_SECTIONS: readonly CatalogueSection[] = WALLET_SAVED_IDS.map((id): CatalogueSection => ({
+  id,
+  title: WALLET_SAVED_TITLES[id],
+  group: 'Screens',
+  layout: 'screen',
+  render: () => (
+    <Suspense fallback={<Loading />}>
+      <SavedScreenSection id={id} />
+    </Suspense>
+  ),
+}));
diff --git a/apps/app/src/wallet/saved/SaveFlight.tsx b/apps/app/src/wallet/saved/SaveFlight.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6bb863078834e05c5311fabc6a2d465f7ae8d280
--- /dev/null
+++ b/apps/app/src/wallet/saved/SaveFlight.tsx
@@ -0,0 +1,138 @@
+// The drop into the card (P2-T17; bw-saved, ax-motion's save, W6, R65, R114):
+// when a save lands, a chip naming it, with its amount, travels from the bottom
+// centre of the screen to its wallet's card on the gentle spring, shrinking and
+// fading as it lands. Only at full motion (motionFor('save') says fly) and only
+// while that card is on screen (useCardFrames, P2-T12); otherwise nothing
+// travels.
+//
+// - It starts once the tray has left: onSaved comes before the tray closes
+//   (P2-T16), and the tray's Modal covers the screen until its exit ends
+//   (TRAY_EXIT_MS). Then it measures every card again, since a frame does not
+//   follow a reorder, a swapped wallet, a moved ancestor or a scroll (P2-T12's
+//   m2), and reads the frame once those measurements have landed (on the web,
+//   at the next tick).
+// - It lands on the card's top: a card behind the front one shows only its top
+//   STACK_PEEK. Where it lands is its own place in the host's box, which the
+//   shell lays over the whole window (P2-T18); it travels there from the bottom
+//   centre as an offset that springs to nothing.
+// - The chip is decorative (the toast says what happened). In private mode it
+//   shows the mask for its amount and no title, which may quote the person
+//   (R65, R114).
+import { useEffect, useState } from 'react';
+import { useWindowDimensions, View } from 'react-native';
+import Animated, { ReduceMotion, useAnimatedStyle, useSharedValue, withSpring } from 'react-native-reanimated';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+
+import { Text } from '@mobile/theme/AppText';
+import { motion } from '@mobile/theme/motion';
+import { useWalletColors } from '@mobile/theme/ThemeProvider';
+import { LATIN_UI_FONT_FAMILY } from '@mobile/theme/uiFontFamily';
+import { DECORATIVE } from '@mobile/ui/a11y';
+import { useCardFrames } from '../card/cardFrames';
+import { STACK_PEEK } from '../card/CardStack';
+import { HIDDEN_AMOUNT, walletMoneyText } from '../money/walletMoney';
+import type { MoneySign } from '../money/walletMoney';
+import { useWalletReducedMotion } from '../motion/reducedMotion';
+import { TRAY_EXIT_MS } from '../motion/useWalletMotion';
+import { motionFor } from '../motion/walletMotion';
+import { usePrivateMode } from '../privacy/PrivateModeProvider';
+import { WalletText } from '../WalletText';
+import type { SavedNotice } from './savedMoment';
+
+/** How long a flight lasts: by then the gentle spring has all but landed (above 99%) and the chip has faded. */
+export const FLIGHT_MS = 800;
+/** Where the chip starts: this far above the screen's bottom safe area, about where the tray's Save was. */
+export const FROM_BOTTOM = 96;
+/** Half the chip's height (bw-saved's 36 pt), so its middle lands on the point. */
+export const CHIP_HALF = 18;
+/** The chip's room: the screen's width less a 16 pt margin on each side. */
+export const CHIP_MARGIN = 16;
+
+type Point = { x: number; y: number };
+type Flight = { notice: SavedNotice; to: Point };
+
+const SIGNS: Readonly<Record<SavedNotice['kind'], MoneySign>> = { expense: 'expense', income: 'income', transfer: 'none' };
+
+export function SaveFlight({ notice }: { notice: SavedNotice | null }) {
+  const reduced = useWalletReducedMotion();
+  const { frameOf, measure } = useCardFrames();
+  const [flight, setFlight] = useState<Flight | null>(null);
+  useEffect(() => {
+    const walletId = notice?.walletId ?? null;
+    // Decided as the save lands, from the wallet's one answer (W6): under Reduce Motion nothing travels.
+    if (notice === null || walletId === null || motionFor('save', reduced).motion.kind !== 'fly') return undefined;
+    let live = true;
+    const timers: ReturnType<typeof setTimeout>[] = [];
+    const after = (ms: number, run: () => void) => {
+      timers.push(setTimeout(() => {
+        if (live) run();
+      }, ms));
+    };
+    after(TRAY_EXIT_MS, () => {
+      measure();
+      after(0, () => {
+        const frame = frameOf(walletId);
+        if (frame === null) return;
+        setFlight({ notice, to: { x: frame.x + frame.width / 2, y: frame.y + STACK_PEEK / 2 } });
+        after(FLIGHT_MS, () => setFlight(null));
+      });
+    });
+    return () => {
+      live = false;
+      timers.forEach(clearTimeout);
+    };
+    // Once per notice: the host keys this part by its notice, and the flight is decided as the save lands.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [notice]);
+  return flight === null ? null : <FlyingChip flight={flight} />;
+}
+
+function FlyingChip({ flight }: { flight: Flight }) {
+  const colors = useWalletColors();
+  const { hidden } = usePrivateMode();
+  const { width, height } = useWindowDimensions();
+  const insets = useSafeAreaInsets();
+  const { notice, to } = flight;
+  const room = width - 2 * CHIP_MARGIN;
+  // From the bottom centre, as an offset from where it lands.
+  const dx = width / 2 - to.x;
+  const dy = height - insets.bottom - FROM_BOTTOM - to.y;
+  const progress = useSharedValue(0);
+  useEffect(() => {
+    progress.value = withSpring(1, { ...motion.spring.gentle, reduceMotion: ReduceMotion.Never });
+  }, [progress]);
+  // The dependency array names the shared value itself (R72).
+  const travel = useAnimatedStyle(() => ({
+    opacity: 1 - progress.value * progress.value,
+    transform: [{ translateX: dx * (1 - progress.value) }, { translateY: dy * (1 - progress.value) }, { scale: 1 - progress.value / 2 }],
+  }), [progress, dx, dy]);
+  return (
+    <View
+      {...DECORATIVE}
+      testID="save-flight"
+      pointerEvents="none"
+      style={{ position: 'absolute', left: to.x - room / 2, top: to.y - CHIP_HALF, width: room, alignItems: 'center', zIndex: 20 }}
+    >
+      <Animated.View
+        style={[
+          {
+            minHeight: 2 * CHIP_HALF,
+            maxWidth: room,
+            flexDirection: 'row',
+            alignItems: 'center',
+            gap: 8,
+            paddingHorizontal: 12,
+            borderRadius: 12,
+            backgroundColor: colors.isDark ? colors.raised : colors.card,
+          },
+          travel,
+        ]}
+      >
+        {hidden ? null : <WalletText testID="save-flight-title" role="caption" style={{ fontWeight: '500', flexShrink: 1 }}>{notice.title}</WalletText>}
+        <Text testID="save-flight-amount" style={{ fontFamily: LATIN_UI_FONT_FAMILY, fontWeight: '700', fontSize: 13, color: colors.ink }}>
