+test("today's rates answer unchanged for the cached ETag", async () => {
+  replies.push(
+    { status: 200, body: NOV_3, headers: { etag: '"r3"' } },
+    { status: 304, headers: { etag: '"r3"' } },
+    { status: 200, body: NOV_3 },
+    { status: 200, body: { ...NOV_3, rates: { ...NOV_3.rates, JPY: { per_base: '0', day: '2026-11-03' } } }, headers: { etag: '"r4"' } },
+    { status: 503, body: { code: 'SERVICE_UNAVAILABLE', request_id: 'r', message_key: 'm', retry_after_seconds: 300 } },
+  );
+  const r = resources();
+  const answers: unknown[] = [];
+  for (const etag of [undefined, '"r3"', '"r3"', undefined, '"r3"']) answers.push(await answer(() => r.ratesToday(etag)));
+  assert.deepEqual(seen.map((request) => [request.method, request.url, request.headers['if-none-match'] ?? null]), [
+    ['GET', '/v1/rates/today', null],
+    ['GET', '/v1/rates/today', '"r3"'],
+    ['GET', '/v1/rates/today', '"r3"'],
+    ['GET', '/v1/rates/today', null],
+    ['GET', '/v1/rates/today', '"r3"'],
+  ]);
+  // A 200 without an ETag answers null, never the ETag the read was sent with.
+  assert.deepEqual(answers, [{ etag: '"r3"', rates: NOV_3 }, 'unchanged', { etag: null, rates: NOV_3 }, 'invalid_response', 'unavailable']);
+});
