+/** A call's answer, or its refusal's outcome, so a case's every check is an assertion. */
+async function answer(run: () => Promise<unknown>): Promise<unknown> {
+  try {
+    return await run();
+  } catch (error) {
+    if (error instanceof V1Error) return error.outcome;
+    throw error;
+  }
