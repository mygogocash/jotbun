+test('trips are created, edited and deleted with their keys and versions, and listed and summarised against their validators', async () => {
+  const keys = [randomUUID(), randomUUID(), randomUUID()];
+  const acks = [
+    { ...ACK, command_id: keys[0], entity_id: TRIP.id, outcome: 'created' },
+    { ...ACK, command_id: keys[1], entity_id: TRIP.id, version: 2, outcome: 'updated' },
+    { ...ACK, command_id: keys[2], entity_id: TRIP.id, version: 3, outcome: 'deleted', entity_state: 'deleted' },
+  ];
+  replies.push({ status: 201, body: acks[0] }, { status: 200, body: acks[1] }, { status: 200, body: acks[2] }, { status: 200, body: [TRIP] }, { status: 200, body: SUMMARY });
+  const create = { id: TRIP.id, name: TRIP.name, currency: 'JPY', starts_on: '2026-11-01', ends_on: '2026-11-08', budget_minor: '120000' };
+  const r = resources();
+  const answers = [
+    await answer(() => r.createTrip(create, keys[0])),
+    await answer(() => r.updateTrip(TRIP.id, 1, { ends_on: '2026-11-09' }, keys[1])),
+    await answer(() => r.deleteTrip(TRIP.id, 2, keys[2])),
+    await answer(() => r.trips()),
+    await answer(() => r.tripSummary(TRIP.id)),
+  ];
+  const schema = String(V1_COMMAND_SCHEMA);
+  assert.deepEqual(seen.map((request) => [request.method, request.url, request.headers['idempotency-key'] ?? null, request.headers['x-gogospend-command-schema'] ?? null, request.headers['if-match'] ?? null, request.body === '' ? null : JSON.parse(request.body)]), [
+    ['POST', '/v1/trips', keys[0], schema, null, create],
+    ['PATCH', `/v1/trips/${TRIP.id}`, keys[1], schema, '"1"', { ends_on: '2026-11-09' }],
+    ['DELETE', `/v1/trips/${TRIP.id}`, keys[2], schema, '"2"', null],
+    ['GET', '/v1/trips', null, null, null, null],
+    ['GET', `/v1/trips/${TRIP.id}/summary`, null, null, null, null],
+  ]);
+  assert.deepEqual(answers, [...acks, [TRIP], SUMMARY]);
+  // Refused, never coerced: an acknowledgement for another trip, a trip or a summary its validator refuses.
+  const other = randomUUID();
+  const refused: [() => Promise<unknown>, Reply][] = [
+    [() => r.createTrip(create, keys[0]), { status: 201, body: { ...acks[0], entity_id: other } }],
+    [() => r.updateTrip(TRIP.id, 1, { ends_on: '2026-11-09' }, keys[1]), { status: 200, body: { ...acks[1], entity_id: other } }],
+    [() => r.deleteTrip(TRIP.id, 2, keys[2]), { status: 200, body: { ...acks[2], entity_id: other } }],
+    [() => r.trips(), { status: 200, body: [{ ...TRIP, budget_minor: 120000 }] }],
+    [() => r.trips(), { status: 200, body: [{ ...TRIP, owner: 'x' }] }],
+    [() => r.tripSummary(TRIP.id), { status: 200, body: { ...SUMMARY, days: [{ spent_trip_minor: '6180', spent_home_minor: '142881', other_home_minor: '0' }] } }],
+  ];
+  const outcomes: unknown[] = [];
+  for (const [run, reply] of refused) {
+    replies.push(reply);
+    outcomes.push(await answer(run));
+  }
+  // A malformed id is refused before anything is sent.
+  const sent = seen.length;
+  outcomes.push(await answer(() => r.updateTrip('not-a-uuid', 1, { name: 'x' }, randomUUID())), await answer(() => r.deleteTrip('not-a-uuid', 1, randomUUID())), await answer(() => r.tripSummary('not-a-uuid')));
+  assert.deepEqual([outcomes, seen.length - sent], [['invalid_response', 'invalid_response', 'invalid_response', 'invalid_response', 'invalid_response', 'invalid_response', 'invalid', 'invalid', 'invalid'], 0]);
+});
