+/** A record tagged with a trip: it carries every money key (P5-T2: all or none). */
+type TaggedRecord = TransactionDto & RecordMoney;
+type TaggedExpense = EntryDto & RecordMoney;
+
+/** Larger amounts first. */
+const largerFirst = (a: string, b: string) => (BigInt(a) === BigInt(b) ? 0 : BigInt(a) > BigInt(b) ? -1 : 1);
+
+/** P5-T12's sums (X17) over expenses: their stored amounts, never a rate. */
+function tripMoney(expenses: readonly TaggedRecord[], tripCurrency: CurrencyCode): TripMoney {
+  let home = 0n;
+  let inTrip = 0n;
+  let other = 0n;
+  for (const record of expenses) {
+    home += BigInt(record.home_amount_minor);
+    if (record.currency === tripCurrency) inTrip += BigInt(record.amount_minor);
+    else other += BigInt(record.home_amount_minor);
+  }
+  return { spent_home_minor: home.toString(), spent_trip_minor: inTrip.toString(), other_home_minor: other.toString() };
+}
