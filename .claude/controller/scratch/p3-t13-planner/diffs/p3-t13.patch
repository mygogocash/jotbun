diff --git a/apps/app/src/wallet/add/draftOrigin.test.ts b/apps/app/src/wallet/add/draftOrigin.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b16cc51c34057d2d7e362398d245c31afe2ecc1b
--- /dev/null
+++ b/apps/app/src/wallet/add/draftOrigin.test.ts
@@ -0,0 +1,38 @@
+// The add tray's draft origin (P3-T13): the fields a draft review compares,
+// read from the tray's draft and the amount its keypad settles on.
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { QuickAddDraft } from '../../spend/v1/redesign/quickAddModel.ts';
+import { draftFieldsOf } from './draftOrigin.ts';
+
+const CASH = '0000000a-0000-4000-8000-000000000002';
+const MAIN = '0000000a-0000-4000-8000-000000000001';
+const FOOD = '0000000c-0000-4000-8000-000000000001';
+const SALARY = '0000000c-0000-4000-8000-000000000004';
+
+/** ฿65 at the motorbike taxi from cash, with a note; the keypad holds the amount, so the draft's own is stale. */
+const DRAFT: QuickAddDraft = {
+  mode: 'create', recordId: '0000000b-0000-4000-8000-0000000000a1', commandId: '0000000b-0000-4000-8000-0000000000a2', type: 'expense',
+  amountMinor: '999', occurredOn: '2026-11-12', walletId: CASH, categoryByType: { expense: FOOD, income: SALARY },
+  fromWalletId: MAIN, toWalletId: CASH, note: 'ค่าข้าวกับพี่', merchant: 'วิน',
+};
+
+test("draftFieldsOf reads the draft's fields and the settled amount", () => {
+  // Spending: the amount passed (never the draft's own), its category, the wallet it is paid from, the place and the note.
+  assert.deepEqual(draftFieldsOf(DRAFT, '6500'), {
+    type: 'expense', amountMinor: '6500', occurredOn: '2026-11-12', categoryId: FOOD, walletId: CASH, merchant: 'วิน', note: 'ค่าข้าวกับพี่',
+  });
+  // Income: income's own category.
+  assert.deepEqual(draftFieldsOf({ ...DRAFT, type: 'income' }, '3000000'), {
+    type: 'income', amountMinor: '3000000', occurredOn: '2026-11-12', categoryId: SALARY, walletId: CASH, merchant: 'วิน', note: 'ค่าข้าวกับพี่',
+  });
+  // A move: no category, and the wallet it leaves.
+  assert.deepEqual(draftFieldsOf({ ...DRAFT, type: 'transfer' }, '50000'), {
+    type: 'transfer', amountMinor: '50000', occurredOn: '2026-11-12', categoryId: null, walletId: MAIN, merchant: 'วิน', note: 'ค่าข้าวกับพี่',
+  });
+  // A keypad that settles on no amount is none; empty words stay as the draft holds them (the review counts '' as none).
+  assert.deepEqual(draftFieldsOf({ ...DRAFT, note: '', merchant: '', categoryByType: { expense: null, income: null }, walletId: null }, null), {
+    type: 'expense', amountMinor: null, occurredOn: '2026-11-12', categoryId: null, walletId: null, merchant: '', note: '',
+  });
+});
diff --git a/apps/app/src/wallet/add/draftOrigin.ts b/apps/app/src/wallet/add/draftOrigin.ts
new file mode 100644
index 0000000000000000000000000000000000000000..22ae6503e7b4a661b2a2e02c6e703de88439a9ba
--- /dev/null
+++ b/apps/app/src/wallet/add/draftOrigin.ts
@@ -0,0 +1,37 @@
+// How the add tray's entry was made (P3-T13; H9): the source its save gives
+// the record, and, for a draft an AI model made, what the draft review
+// (P3-T5) compares the saved record with. Pure: a Node test reads it, so it
+// imports by relative path and loads no React or React Native.
+//
+// - A typed entry is `typed`, with nothing to review. P2's Tell Bun sheet
+//   gives `tell_bun`, also with nothing to review: the sheet does not say
+//   which model read the sentence. A draft handed to applyAiDraft gives its
+//   own source (`tell_bun` or `photo`), and its review keeps the model, whether
+//   Opus answered, and the entry as the tray showed it once the draft filled
+//   it (`original`).
+// - draftFieldsOf turns a tray's draft into the review's fields: the type, the
+//   amount it settles on (the tray keeps the amount on its keypad, so the
+//   caller passes it), the date, the type's category (none for a move), the
+//   wallet (for a move, the one it leaves), the merchant and the note.
+import type { TransactionSource } from '@gogospend/contracts';
+
+import type { AiModelName } from '../../analytics/events.ts';
+import type { DraftFields } from '../../spend/v1/ai/draftReview.ts';
+import type { QuickAddDraft } from '../../spend/v1/redesign/quickAddModel.ts';
+
+export type DraftOrigin = { source: TransactionSource; review: { original: DraftFields; model: AiModelName; escalated: boolean } | null };
+
+export const TYPED_ORIGIN: DraftOrigin = { source: 'typed', review: null };
+
+export function draftFieldsOf(draft: QuickAddDraft, amountMinor: string | null): DraftFields {
+  const move = draft.type === 'transfer';
+  return {
+    type: draft.type,
+    amountMinor,
+    occurredOn: draft.occurredOn,
+    categoryId: draft.type === 'transfer' ? null : draft.categoryByType[draft.type],
+    walletId: move ? draft.fromWalletId : draft.walletId,
+    merchant: draft.merchant,
+    note: draft.note,
+  };
+}
