+// 1C-T8, with the `signin` area on (K16, R55): the story ends at sign-in, and the reminder question follows it.
+test('the story ends at sign-in from onboarding, or with a session at the reminder question', () => {
+  assert.equal(afterStory(false), '/login?from=onboarding');
+  assert.equal(afterStory(true), '/onboarding/reminder');
+});
+
+test('an active sign-in from onboarding goes on to the reminder question; anywhere else, to the diary', () => {
+  assert.deepEqual(afterSignInAttempt('active', 'onboarding'), { state: { phase: 'idle' }, go: '/onboarding/reminder' });
+  assert.deepEqual(afterSignInAttempt('active', undefined), { state: { phase: 'idle' }, go: '/spend' });
+  assert.deepEqual(afterSignInAttempt('failed', 'onboarding'), { state: { phase: 'failed' }, go: null });
+  assert.deepEqual(afterSignInAttempt('cancelled', 'onboarding'), { state: { phase: 'idle' }, go: null });
