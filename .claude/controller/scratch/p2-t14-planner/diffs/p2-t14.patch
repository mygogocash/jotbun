@@ -0,0 +1,71 @@
+// The quick chips (bw-tray-amount, ax-large-tray): at most three things this
+// person often logs, each its name and its amount. A tap fills the entry
+// through the host's `apply` (P2-T16 builds them from today's often-logged
+// list) and ticks once (chipPick). By default they are a row of 44 pt pills
+// that wraps (§4: the boards draw 36 pt). At the largest text sizes they are a
+// list of full-width rows of at least 64 pt, where a long name pushes the
+// amount onto the next line. The amount is WalletAmount's, so private mode
+// masks it (W10), and each chip says its name and its amount (add.chip), or
+// that the amount is hidden.
+import type { Minor } from '@gogospend/contracts';
+import { Pressable, View } from 'react-native';
+
+import { playHaptic } from '@mobile/lib/hapticMoment';
+import { useWalletColors } from '@mobile/theme/ThemeProvider';
+import { useLargeText } from '@mobile/ui/largeText';
+import { COMMON_COPY } from '../common/copy';
+import { useDraftCopy } from '../copy/useDraftCopy';
+import { WalletAmount } from '../money/WalletAmount';
+import { spokenMoney } from '../money/walletMoney';
+import { usePrivateMode } from '../privacy/PrivateModeProvider';
+import { WalletText } from '../WalletText';
+import { COPY } from './copy';
+
+export type QuickChip = { label: string; amountMinor: Minor; apply(): void };
+
+const LINES = { ...COMMON_COPY, ...COPY } as const;
+
+/** The most chips the step shows. */
+const MOST = 3;
+
+export function QuickChips({ chips }: { chips: readonly QuickChip[] }) {
+  const colors = useWalletColors();
+  const t = useDraftCopy(LINES);
+  const large = useLargeText();
+  const { hidden } = usePrivateMode();
+  const shown = chips.slice(0, MOST);
+  if (shown.length === 0) return null;
+  return (
+    <View
+      testID="quick-chips"
+      style={large
+        ? { flexDirection: 'column', borderWidth: 1, borderColor: colors.hairline, borderRadius: 18, overflow: 'hidden' }
+        : { flexDirection: 'row', flexWrap: 'wrap', gap: 8 }}
+    >
+      {shown.map((chip, index) => (
+        <Pressable
+          key={index}
+          accessibilityRole="button"
+          accessibilityLabel={t('add.chip', { label: chip.label, amount: hidden ? t('common.amountHidden') : spokenMoney(chip.amountMinor, t) })}
+          onPress={() => {
+            playHaptic('chipPick');
+            chip.apply();
+          }}
+          style={({ pressed }) => ({
+            flexDirection: 'row',
+            flexWrap: 'wrap',
+            alignItems: large ? 'baseline' : 'center',
+            columnGap: large ? 14 : 6,
+            opacity: pressed ? 0.7 : 1,
+            ...(large
+              ? { minHeight: 64, alignContent: 'center', paddingVertical: 8, paddingHorizontal: 16, borderTopWidth: index === 0 ? 0 : 1, borderColor: colors.hairline }
+              : { minHeight: 44, flexShrink: 1, paddingHorizontal: 14, borderRadius: 22, borderWidth: 1, borderColor: colors.hairline, backgroundColor: colors.card }),
+          })}
+        >
+          <WalletText role="label">{chip.label}</WalletText>
+          <WalletAmount minor={chip.amountMinor} size={16} />
+        </Pressable>
+      ))}
+    </View>
+  );
+}
diff --git a/apps/app/src/wallet/add/TypeSwitchHeader.tsx b/apps/app/src/wallet/add/TypeSwitchHeader.tsx
new file mode 100644
index 0000000..d628d85
--- /dev/null
+++ b/apps/app/src/wallet/add/TypeSwitchHeader.tsx
@@ -0,0 +1,73 @@
+// The add tray's header (W14; rh-income, rh-transfer): one segmented control
+// for spending, income and moving money. It takes the title's place in the
+// tray's header row, where the title still names the dialog and is what a
+// screen reader meets first (P2-T13). A radio group named ประเภทรายการ, as the
+// boards name it and as today's TypeSwitch is a radio group: the chosen type
+// is a `card` segment with bold ink words (lifted by a soft shadow by day),
+// the others quiet on the `raised` track, so the choice never rests on the
+// fill alone. Each segment is at least 44 pt (§4); at the largest text sizes
+// the three stack, so each word stays whole. A new choice ticks once
+// (segmentChange); the chosen one does nothing.
+import { Pressable, View } from 'react-native';
+
+import { playHaptic } from '@mobile/lib/hapticMoment';
+import { useWalletColors } from '@mobile/theme/ThemeProvider';
+import { useLargeText } from '@mobile/ui/largeText';
+import { useDraftCopy } from '../copy/useDraftCopy';
+import { WalletText } from '../WalletText';
+import type { AddType } from './addFlow';
+import { COPY } from './copy';
+
+const TYPES: readonly AddType[] = ['expense', 'income', 'transfer'];
+const LABELS = { expense: 'add.typeExpense', income: 'add.typeIncome', transfer: 'add.typeTransfer' } as const;
+
+/** A segment's height (rh-income), and the chosen one's lift by day. */
+const SEGMENT = 44;
+const LIFT = '0px 1px 4px rgba(17, 16, 20, 0.14)';
+
+export function TypeSwitchHeader({ type, onType }: { type: AddType; onType(type: AddType): void }) {
+  const colors = useWalletColors();
+  const t = useDraftCopy(COPY);
+  const large = useLargeText();
+  return (
+    <View
+      testID="type-switch"
+      role="radiogroup"
+      accessibilityLabel={t('add.typeGroup')}
+      style={{ flexDirection: large ? 'column' : 'row', gap: 2, padding: 4, borderRadius: 17, backgroundColor: colors.raised }}
+    >
+      {TYPES.map((each) => {
+        const checked = each === type;
+        return (
+          <Pressable
+            key={each}
+            accessibilityRole="radio"
+            accessibilityLabel={t(LABELS[each])}
+            accessibilityState={{ checked }}
+            aria-checked={checked}
+            onPress={() => {
+              if (checked) return;
+              playHaptic('segmentChange');
+              onType(each);
+            }}
+            style={{
+              flex: large ? undefined : 1,
+              minHeight: SEGMENT,
+              borderRadius: 13,
+              paddingHorizontal: 8,
+              paddingVertical: 4,
+              alignItems: 'center',
+              justifyContent: 'center',
+              backgroundColor: checked ? colors.card : 'transparent',
+              boxShadow: checked && !colors.isDark ? LIFT : undefined,
+            }}
+          >
+            <WalletText role="label" tone={checked ? 'ink' : 'quiet'} style={{ fontWeight: checked ? '700' : '500', textAlign: 'center' }}>
+              {t(LABELS[each])}
+            </WalletText>
+          </Pressable>
+        );
+      })}
+    </View>
+  );
+}
diff --git a/apps/app/src/wallet/add/WalletKeypad.tsx b/apps/app/src/wallet/add/WalletKeypad.tsx
new file mode 100644
index 0000000..0e9473e
--- /dev/null
+++ b/apps/app/src/wallet/add/WalletKeypad.tsx
@@ -0,0 +1,90 @@
+// The add tray's keypad (W29; bw-tray-amount, rh-income, ax-large-tray): 1 to
+// 9, then 000, 0 and delete, three to a row. It types through today's exact
+// rules (applyKey, src/ui/keypadExpression.ts), so an amount stays satang and
+// a key that would pass ฿999,999,999.99 is refused, its problem set for the
+// host to show. No operators and no decimal point: Quick add keeps those. The
+// keys are buttons in DM Sans, as the boards draw them, at least 46 pt tall
+// (§4's 44 pt), with nothing behind them until pressed. At the largest text
+// sizes they are 56 pt on `raised` with the digits capped at 34 pt, so each
+// reads as a target and keeps its digits (the host pins the keypad in the
+// tray's footer, so it never scrolls). Each press ticks once (keyTap).
+import { Pressable, View } from 'react-native';
+
+import { playHaptic } from '@mobile/lib/hapticMoment';
+import { Text } from '@mobile/theme/AppText';
+import { useWalletColors } from '@mobile/theme/ThemeProvider';
+import { LATIN_UI_FONT_FAMILY } from '@mobile/theme/uiFontFamily';
+import { walletLineHeight } from '@mobile/theme/walletType';
+import { Glyph } from '@mobile/ui/Glyph';
+import { applyKey } from '@mobile/ui/keypadExpression';
+import type { KeypadKey, KeypadState } from '@mobile/ui/keypadExpression';
+import { useLargeText } from '@mobile/ui/largeText';
+import { useDraftCopy } from '../copy/useDraftCopy';
+import { COPY } from './copy';
+
+const ROWS: readonly (readonly KeypadKey[])[] = [
+  ['1', '2', '3'],
+  ['4', '5', '6'],
+  ['7', '8', '9'],
+  ['000', '0', 'backspace'],
+];
+
+/** A key's height (bw-tray-amount; ax-large-tray at the largest text sizes). */
+const KEY = 46;
+const LARGE_KEY = 56;
+/** Digits at 24 pt and 000 at 20 (the boards), at most 34 and 28 pt (ax-large-tray). */
+const DIGIT = 24;
+const TRIPLE = 20;
+const DIGIT_CAP = 34 / 24;
+
+export function WalletKeypad({ keypad, onKeypad, disabled = false }: { keypad: KeypadState; onKeypad(next: KeypadState): void; disabled?: boolean }) {
+  const colors = useWalletColors();
+  const t = useDraftCopy(COPY);
+  const large = useLargeText();
+  const press = (key: KeypadKey) => {
+    playHaptic('keyTap');
+    onKeypad(applyKey(keypad, key));
+  };
+  return (
+    <View testID="wallet-keypad" style={{ gap: 4 }}>
+      {ROWS.map((row) => (
+        <View key={row.join(' ')} style={{ flexDirection: 'row', gap: large ? 6 : 8 }}>
+          {row.map((key) => {
+            const size = key === '000' ? TRIPLE : DIGIT;
+            return (
+              <Pressable
+                key={key}
+                accessibilityRole="button"
+                accessibilityLabel={key === 'backspace' ? t('add.deleteKey') : key}
+                accessibilityState={{ disabled }}
+                aria-disabled={disabled}
+                disabled={disabled}
+                onPress={() => press(key)}
+                style={({ pressed }) => ({
+                  flex: 1,
+                  minHeight: large ? LARGE_KEY : KEY,
+                  borderRadius: 14,
+                  backgroundColor: large || pressed ? colors.raised : 'transparent',
+                  alignItems: 'center',
+                  justifyContent: 'center',
+                  opacity: disabled ? 0.4 : 1,
+                })}
+              >
+                {key === 'backspace' ? (
+                  <Glyph name="backspace" size={large ? 32 : 24} color={colors.ink} />
+                ) : (
+                  <Text
+                    maxFontSizeMultiplier={DIGIT_CAP}
+                    style={{ fontFamily: LATIN_UI_FONT_FAMILY, fontWeight: '500', fontSize: size, lineHeight: walletLineHeight(size, 'latin'), color: colors.ink }}
+                  >
+                    {key}
+                  </Text>
+                )}
+              </Pressable>
+            );
+          })}
+        </View>
+      ))}
+    </View>
+  );
+}
diff --git a/apps/app/src/wallet/add/addFlow.test.ts b/apps/app/src/wallet/add/addFlow.test.ts
new file mode 100644
index 0000000..b5f8d7d
--- /dev/null
+++ b/apps/app/src/wallet/add/addFlow.test.ts
@@ -0,0 +1,141 @@
+// The add flow's rules (P2-T14; W14, W29; bw-tray-confirm, rh-transfer): the
+// tray's title by type; where the amount's Next goes; which keypad problem the
+// amount step shows; the confirm step's rows, and Bun's guesses until the
+// person changes them; move all, offered only for a known balance above zero;
+// and each wallet's balance after a transfer, exact in BigInt.
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { CategoryDto } from '@gogospend/contracts';
+
+import type { QuickAddDraft } from '../../spend/v1/redesign/quickAddModel.ts';
+import type { Lookups } from '../../spend/v1/redesign/shared.ts';
+import { applyKey, EMPTY_KEYPAD, keypadFromMinor } from '../../ui/keypadExpression.ts';
+import type { KeypadKey, KeypadState } from '../../ui/keypadExpression.ts';
+import { amountProblem, balancesAfter, confirmRows, moveAllMinor, stepAfterAmount, stillGuessed, trayTitleKey } from './addFlow.ts';
+
+const TODAY = '2026-10-24';
+
+const category = (id: string, type: 'expense' | 'income', label: string | null, builtin: CategoryDto['builtin_key'] = null): CategoryDto => (
+  { id, type, builtin_key: builtin, label, color: null, archived: false, version: 1 }
+);
+
+const LOOKUPS: Lookups = {
+  wallets: new Map([['w-main', { id: 'w-main', name: 'บัญชีหลัก' }], ['w-cash', { id: 'w-cash', name: 'เงินสด' }]]),
+  categories: new Map([
+    ['c-food', category('c-food', 'expense', null, 'food')],
+    ['c-merit', category('c-merit', 'expense', 'ทำบุญ')],
+    ['c-salary', category('c-salary', 'income', null, 'salary')],
+  ]),
+};
+
+const DRAFT: QuickAddDraft = {
+  mode: 'create', recordId: 'r-1', commandId: 'k-1', type: 'expense', amountMinor: '', occurredOn: TODAY, walletId: 'w-main',
+  categoryByType: { expense: 'c-food', income: 'c-salary' }, fromWalletId: 'w-main', toWalletId: 'w-cash', note: '', merchant: '',
+};
+
+/** The app's copy as tc gives it in Thai, for the built-in categories these cases name. */
+const THAI: Readonly<Record<string, string>> = { Food: 'อาหาร', Salary: 'เงินเดือน' };
+const tc = (english: string) => THAI[english] ?? english;
+
+const context = (guessed: readonly string[] = []) => ({ lookups: LOOKUPS, today: TODAY, dateLocale: 'th' as const, guessed: new Set(guessed), tc });
+const shown = (rows: ReturnType<typeof confirmRows>) => rows.map((row) => [row.key, row.labelKey, row.value]);
+const guessedKeys = (rows: ReturnType<typeof confirmRows>) => rows.filter((row) => row.guessed).map((row) => row.key);
+
+const typed = (...keys: KeypadKey[]): KeypadState => keys.reduce(applyKey, EMPTY_KEYPAD);
+
+test("the tray's title follows its type, and the amount's Next goes to confirm, or a transfer's to its two wallets", () => {
+  assert.equal(trayTitleKey('expense'), 'add.titleExpense');
+  assert.equal(trayTitleKey('income'), 'add.titleIncome');
+  assert.equal(trayTitleKey('transfer'), 'add.titleTransfer');
+  assert.equal(stepAfterAmount('expense'), 'confirm');
+  assert.equal(stepAfterAmount('income'), 'confirm');
+  assert.equal(stepAfterAmount('transfer'), 'transfer');
+});
+
+test('an expense confirms category, wallet, date and note; a transfer confirms from, to, date and note', () => {
+  assert.deepEqual(shown(confirmRows(DRAFT, context())), [
+    ['category', 'add.rowCategory', 'อาหาร'],
+    ['wallet', 'add.rowWallet', 'บัญชีหลัก'],
+    ['date', 'add.rowDate', 'วันนี้'],
+    ['note', 'add.rowNote', ''],
+  ]);
+  // Income names its own category, a custom name as written; yesterday and an earlier day as dateStep says them; the note trimmed.
+  const income = { ...DRAFT, type: 'income' as const, occurredOn: '2026-10-23', note: '  โบนัสปลายปี ' };
+  assert.deepEqual(shown(confirmRows(income, context())).map(([, , value]) => value), ['เงินเดือน', 'บัญชีหลัก', 'เมื่อวาน', 'โบนัสปลายปี']);
+  const merit = { ...DRAFT, categoryByType: { expense: 'c-merit', income: null }, occurredOn: '2026-10-15' };
+  assert.deepEqual(shown(confirmRows(merit, context())).map(([, , value]) => value), ['ทำบุญ', 'บัญชีหลัก', 'พฤหัส 15 ต.ค.', '']);
+  assert.equal(confirmRows(merit, { ...context(), dateLocale: 'en' })[2]?.value, 'Thu 15 Oct');
+  assert.deepEqual(shown(confirmRows({ ...DRAFT, type: 'transfer', note: 'ค่าห้อง' }, context())), [
+    ['from', 'add.rowFrom', 'บัญชีหลัก'],
+    ['to', 'add.rowTo', 'เงินสด'],
+    ['date', 'add.rowDate', 'วันนี้'],
+    ['note', 'add.rowNote', 'ค่าห้อง'],
+  ]);
+  // Nothing chosen, or a wallet or category no longer listed, shows nothing for the step to ask about.
+  const unchosen = { ...DRAFT, walletId: null, categoryByType: { expense: 'c-gone', income: null } };
+  assert.deepEqual(shown(confirmRows(unchosen, context())).map(([, , value]) => value), ['', '', 'วันนี้', '']);
+  assert.deepEqual(shown(confirmRows({ ...DRAFT, type: 'transfer', fromWalletId: 'w-gone', toWalletId: null }, context())).map(([, , value]) => value), ['', '', 'วันนี้', '']);
+});
+
+test('fields Bun filled are marked guessed until the person changes them', () => {
+  const guess = ['category', 'wallet', 'date', 'merchant'];
+  assert.deepEqual(guessedKeys(confirmRows(DRAFT, context(guess))), ['category', 'wallet', 'date']);
+  // The person picks another category: only that row stops being Bun's guess.
+  const picked = { ...DRAFT, categoryByType: { ...DRAFT.categoryByType, expense: 'c-merit' } };
+  const afterPick = stillGuessed(new Set(guess), DRAFT, picked);
+  assert.deepEqual([...afterPick], ['wallet', 'date', 'merchant']);
+  assert.deepEqual(guessedKeys(confirmRows(picked, context([...afterPick]))), ['wallet', 'date']);
+  // A change that leaves every row as it was keeps every guess; the same value set again is no change.
+  assert.deepEqual([...stillGuessed(new Set(guess), DRAFT, { ...DRAFT, amountMinor: '5000' })], guess);
+  assert.deepEqual([...stillGuessed(new Set(guess), DRAFT, { ...DRAFT })], guess);
+  // A new day and a new wallet are changes too; so is a note, and a type whose category differs.
+  assert.deepEqual([...stillGuessed(new Set(guess), DRAFT, { ...DRAFT, occurredOn: '2026-10-23', walletId: 'w-cash' })], ['category', 'merchant']);
+  assert.deepEqual([...stillGuessed(new Set(['note']), DRAFT, { ...DRAFT, note: 'ข้าวมันไก่' })], []);
+  assert.deepEqual([...stillGuessed(new Set(['category']), DRAFT, { ...DRAFT, type: 'income' })], []);
+  // A transfer's two wallets are their own rows.
+  const transfer = { ...DRAFT, type: 'transfer' as const };
+  assert.deepEqual([...stillGuessed(new Set(['from', 'to']), transfer, { ...transfer, fromWalletId: 'w-cash', toWalletId: 'w-main' })], []);
+  assert.deepEqual(guessedKeys(confirmRows(transfer, context(['from', 'to', 'date']))), ['from', 'to', 'date']);
+});
+
+test('move all offers the available balance only when it is known and above zero', () => {
+  const balances = new Map([['w-main', '2486000'], ['w-zero', '0'], ['w-owed', '-500'], ['w-satang', '1']]);
+  assert.equal(moveAllMinor(null, 'w-main'), null);
+  assert.equal(moveAllMinor(balances, 'w-zero'), null);
+  assert.equal(moveAllMinor(balances, 'w-owed'), null);
+  assert.equal(moveAllMinor(balances, 'w-gone'), null);
+  assert.equal(moveAllMinor(balances, null), null);
+  assert.equal(moveAllMinor(balances, 'w-main'), '2486000');
+  assert.equal(moveAllMinor(balances, 'w-satang'), '1');
+});
+
+test('balances after a transfer move the exact amount', () => {
+  const balances = new Map([['w-main', '2486000'], ['w-cash', '124000'], ['w-card', '-392000'], ['w-big', '99999999999'], ['w-huge', '9007199254740993']]);
+  // rh-transfer's numbers: ฿24,860 and ฿1,240, with ฿500 moved.
+  assert.deepEqual(balancesAfter(balances, 'w-main', 'w-cash', '50000'), { from: '2436000', to: '174000' });
+  // Below zero, and past what a JS number holds exactly (2^53 + 1), still to the satang.
+  assert.deepEqual(balancesAfter(balances, 'w-big', 'w-card', '99999999999'), { from: '0', to: '99999607999' });
+  assert.deepEqual(balancesAfter(balances, 'w-card', 'w-big', '1'), { from: '-392001', to: '100000000000' });
+  assert.deepEqual(balancesAfter(balances, 'w-huge', 'w-cash', '1'), { from: '9007199254740992', to: '124001' });
+  // A balance that is not known stays unknown; offline nothing is known.
+  assert.deepEqual(balancesAfter(balances, 'w-gone', 'w-cash', '50000'), { from: null, to: '174000' });
+  assert.deepEqual(balancesAfter(balances, 'w-main', null, '50000'), { from: '2436000', to: null });
+  assert.deepEqual(balancesAfter(null, 'w-main', 'w-cash', '50000'), { from: null, to: null });
+  // One wallet on both sides moves nothing.
+  assert.deepEqual(balancesAfter(balances, 'w-main', 'w-main', '50000'), { from: '2486000', to: '2486000' });
+});
+
+test("the amount step's problem: a refused key's, else why the amount cannot go on, but nothing for a keypad nothing was typed on", () => {
+  assert.equal(amountProblem(EMPTY_KEYPAD), null);
+  assert.equal(amountProblem(typed('5', 'backspace')), null);
+  assert.equal(amountProblem(typed('5', '0')), null);
+  assert.equal(amountProblem(typed('0')), 'zero');
+  assert.equal(amountProblem(typed('000')), 'zero');
+  // A tenth digit passes ฿999,999,999.99: refused, so the amount stays and says why.
+  const nine = typed('9', '9', '9', '9', '9', '9', '9', '9', '9');
+  assert.equal(amountProblem(nine), null);
+  assert.equal(amountProblem(applyKey(nine, '9')), 'too_large');
+  assert.equal(amountProblem(applyKey(applyKey(nine, '9'), 'backspace')), null);
+  assert.equal(amountProblem(keypadFromMinor('99999999999')), null);
+});
diff --git a/apps/app/src/wallet/add/addFlow.ts b/apps/app/src/wallet/add/addFlow.ts
new file mode 100644
index 0000000..b59d522
--- /dev/null
+++ b/apps/app/src/wallet/add/addFlow.ts
@@ -0,0 +1,150 @@
+// The Bun Wallet's add flow (P2-T14; W14, W29; bw-tray-amount, rh-income,
+// rh-transfer, bw-tray-confirm): the tray's types and steps, and the rules its
+// steps share. One tray serves spending, income and money moved between the
+// person's own wallets (W14). Every step is controlled by its host through
+// StepProps, so the add tray (P2-T16) and the edit tray (P2-T27) drive the
+// same steps. Money stays exact: satang strings through BigInt, never a JS
+// number. Pure: a Node test reads it, so it imports by relative path and
+// loads no React or React Native.
+import type { Minor } from '@gogospend/contracts';
+
+import type { QuickAddDraft } from '../../spend/v1/redesign/quickAddModel.ts';
+import type { Lookups, Translate } from '../../spend/v1/redesign/shared.ts';
+import { categoryName } from '../../spend/v1/viewModels.ts';
+import { dayLabel } from '../../ui/dateStep.ts';
+import type { DateLocale } from '../../ui/dateStep.ts';
+import { evaluateKeypad } from '../../ui/keypadExpression.ts';
+import type { KeypadProblem, KeypadState } from '../../ui/keypadExpression.ts';
+
+/** What the tray adds: spending, income, or money moved between the person's own wallets (W14). */
+export type AddType = 'expense' | 'income' | 'transfer';
+
+/**
+ * The tray's steps. Spending and income go amount, then confirm; a transfer
+ * goes amount, transfer (rh-transfer's two wallets), then confirm (P2-T16).
+ * Confirm's rows open the pick steps, which return to confirm (P2-T15).
+ */
+export type AddStep = 'amount' | 'transfer' | 'confirm' | 'category' | 'wallet' | 'from' | 'to' | 'date' | 'note';
+
+/** Every step is controlled: its host holds the draft, the keypad and the step shown. */
+export type StepProps = {
+  draft: QuickAddDraft;
+  keypad: KeypadState;
+  onDraft(next: QuickAddDraft): void;
+  onKeypad(next: KeypadState): void;
+  onStep(step: AddStep): void;
+};
+
+const TITLE_KEYS = { expense: 'add.titleExpense', income: 'add.titleIncome', transfer: 'add.titleTransfer' } as const;
+
+/** The tray's title, which names its dialog: จดรายจ่าย, จดรายรับ or โอนเงิน. */
+export function trayTitleKey(type: AddType): 'add.titleExpense' | 'add.titleIncome' | 'add.titleTransfer' {
+  return TITLE_KEYS[type];
+}
+
+/** Where the amount's Next goes: a transfer chooses its two wallets first. */
+export function stepAfterAmount(type: AddType): AddStep {
+  return type === 'transfer' ? 'transfer' : 'confirm';
+}
+
+/**
+ * The keypad problem the amount step shows above Next, in today's words
+ * (KEYPAD_PROBLEM_TEXT through tc): a refused key's (a tenth digit passes
+ * ฿999,999,999.99), else why the amount cannot go on (zero). A keypad with
+ * nothing typed only keeps Next waiting, and says nothing: nothing nags (§2).
+ */
+export function amountProblem(keypad: KeypadState): KeypadProblem | null {
+  if (keypad.problem !== null) return keypad.problem;
+  const outcome = evaluateKeypad(keypad);
+  return outcome.ok || outcome.problem === 'empty' ? null : outcome.problem;
+}
+
+export type ConfirmRow = { key: 'category' | 'wallet' | 'from' | 'to' | 'date' | 'note'; labelKey: string; value: string; guessed: boolean };
+type RowKey = ConfirmRow['key'];
+
+/** Each row's label: หมวด, กระเป๋า, จาก, ไป, วันที่ and โน้ต, lines P2-T15 adds to add/copy.ts. */
+const ROW_LABELS: Readonly<Record<RowKey, string>> = {
+  category: 'add.rowCategory',
+  wallet: 'add.rowWallet',
+  from: 'add.rowFrom',
+  to: 'add.rowTo',
+  date: 'add.rowDate',
+  note: 'add.rowNote',
+};
+
+/**
+ * The confirm step's rows (bw-tray-confirm): category, wallet, date and note
+ * for spending and income; from, to, date and note for a transfer. Each value
+ * is what its row shows: the category's name (a built-in category's through
+ * `tc`, the app's copy, as every screen names it), the wallet's name, the day
+ * as วันนี้, เมื่อวาน or the date (W12: no time), and the note. A value is empty
+ * when there is nothing chosen or written, and the step says what to add. A
+ * row is `guessed` while Bun filled it and the person has not changed it.
+ */
+export function confirmRows(
+  draft: QuickAddDraft,
+  context: { lookups: Lookups; today: string; dateLocale: DateLocale; guessed: ReadonlySet<string>; tc: Translate },
+): ConfirmRow[] {
+  const { lookups, today, dateLocale, guessed, tc } = context;
+  const row = (key: RowKey, value: string): ConfirmRow => ({ key, labelKey: ROW_LABELS[key], value, guessed: guessed.has(key) });
+  const walletName = (id: string | null) => (id === null ? '' : lookups.wallets.get(id)?.name ?? '');
+  const date = row('date', dayLabel(draft.occurredOn, today, dateLocale).text);
+  const note = row('note', draft.note.trim());
+  if (draft.type === 'transfer') return [row('from', walletName(draft.fromWalletId)), row('to', walletName(draft.toWalletId)), date, note];
+  const categoryId = draft.categoryByType[draft.type];
+  const category = categoryId === null ? undefined : lookups.categories.get(categoryId);
+  return [row('category', category ? categoryName(category, tc) : ''), row('wallet', walletName(draft.walletId)), date, note];
+}
+
+/** What each row shows of the draft, to tell whether the person changed it. */
+const ROW_FIELDS = new Map<string, (draft: QuickAddDraft) => string | null>([
+  ['category', (draft) => (draft.type === 'transfer' ? null : draft.categoryByType[draft.type])],
+  ['wallet', (draft) => draft.walletId],
+  ['from', (draft) => draft.fromWalletId],
+  ['to', (draft) => draft.toWalletId],
+  ['date', (draft) => draft.occurredOn],
+  ['note', (draft) => draft.note],
+]);
+
+/**
+ * What Bun filled stays marked as its guess until the person changes it: each
+ * row whose value changed from `before` to `after` leaves `guessed`. A key
+ * that is not a row stays.
+ */
+export function stillGuessed(guessed: ReadonlySet<string>, before: QuickAddDraft, after: QuickAddDraft): ReadonlySet<string> {
+  const changed = (key: string) => {
+    const field = ROW_FIELDS.get(key);
+    return field !== undefined && field(before) !== field(after);
+  };
+  return new Set([...guessed].filter((key) => !changed(key)));
+}
+
+/**
+ * Move all (rh-transfer): the wallet's available balance, offered only when it
+ * is known and above zero. Offline there are no balances, and no guessed
+ * number is ever offered.
+ */
+export function moveAllMinor(balances: ReadonlyMap<string, Minor> | null, walletId: string | null): Minor | null {
+  if (balances === null || walletId === null) return null;
+  const balance = balances.get(walletId);
+  return balance !== undefined && BigInt(balance) > 0n ? balance : null;
+}
+
+/**
+ * Each card's balance after the move (rh-transfer's หลังโอน), exact in BigInt:
+ * the amount leaves `from` and reaches `to`. A balance that is not known stays
+ * unknown, and one wallet on both sides keeps its balance.
+ */
+export function balancesAfter(
+  balances: ReadonlyMap<string, Minor> | null,
+  fromId: string | null,
+  toId: string | null,
+  amountMinor: Minor,
+): { from: Minor | null; to: Minor | null } {
+  const after = (id: string | null, sign: bigint): Minor | null => {
+    const balance = balances === null || id === null ? undefined : balances.get(id);
+    if (balance === undefined) return null;
+    return fromId === toId ? balance : (BigInt(balance) + sign * BigInt(amountMinor)).toString();
+  };
+  return { from: after(fromId, -1n), to: after(toId, 1n) };
+}
